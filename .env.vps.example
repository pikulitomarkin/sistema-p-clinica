# Copie para .env na VPS: /opt/clinicapsi/.env
POSTGRES_USER=clinicapsi
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=clinicapsi

# Porta no host (Astra ja usa 80/443)
CLINICAPSI_HTTP_PORT=8080

# Domínio canônico da marca (site/WhatsApp/links de e-mail)
PUBLIC_APP_URL=https://psyall.com.br

# Admin opcional no boot (deixe vazio apos criar o usuario)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
# ADMIN_NAME=Administrador
# ADMIN_NOME=Administrador
# ADMIN_RESET_PASSWORD=false

# WhatsApp (opcional)
WHATSAPP_VERIFY_TOKEN=clinicapsi_webhook_token_2025
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_BOT_URL=
OPENAI_API_KEY=

# Mercado Pago — NÃO commitár secrets (só no .env da VPS /opt/clinicapsi/.env)
# Webhook público: https://psyall.com.br/webhook
# ASP.NET lê MercadoPago__* (ou equivalents MERCADOPAGO_*)
MercadoPago__PublicKey=
MercadoPago__AccessToken=
MercadoPago__WebhookSecret=
# MERCADOPAGO_PUBLIC_KEY=
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=

# E-mail Resend — NÃO commitár a chave real (só no .env da VPS)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# From: manter domínio já verificado no Resend (psiianasantos) até verificar psyall.com.br.
# Sem domínio verificado, use noreply@psiianasantos.com.br (só envia para e-mails da conta Resend).
Email__From=noreply@psiianasantos.com.br
Email__FromName=PsyAll

# Videochamada: WebRTC 1:1 + SignalR nativo (sem Jitsi / sem conta no provedor).
# Opcional futuro — Daily.co / LiveKit (deixe vazio; não commitar secrets):
# DAILY_API_KEY=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_URL=
