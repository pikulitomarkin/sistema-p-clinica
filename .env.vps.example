# Copie para .env na VPS: /opt/clinicapsi/.env
POSTGRES_USER=clinicapsi
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=clinicapsi

# Porta no host (Astra ja usa 80/443)
CLINICAPSI_HTTP_PORT=8080

PUBLIC_APP_URL=https://psiianasantos.com.br

# Admin opcional no boot (deixe vazio apos criar o usuario)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
# ADMIN_NAME=Administrador
# ADMIN_NOME=Administrador
# ADMIN_RESET_PASSWORD=false

# WhatsApp (opcional)
WHATSAPP_VERIFY_TOKEN=clinicapsi_webhook_token_2025
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_BOT_URL=
OPENAI_API_KEY=

# E-mail Resend — NÃO commitár a chave real (só no .env da VPS)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Preferir noreply@psiianasantos.com.br após verificar o domínio no Resend.
# Sem domínio verificado, use noreply@psiianasantos.com.br (só envia para e-mails da conta Resend).
Email__From=noreply@psiianasantos.com.br
Email__FromName=Psicóloga Ana Santos

# Videochamada: WebRTC 1:1 + SignalR nativo (sem Jitsi / sem conta no provedor).
# TURN local (coturn) — necessário para NATs restritivos / CGNAT
TURN_EXTERNAL_IP=184.107.160.119
TURN_USER=clinicapsi
TURN_PASSWORD=CHANGE_ME_TURN_PASSWORD
TURN_REALM=psiianasantos.com.br
# Opcional futuro — Daily.co / LiveKit (deixe vazio; não commitar secrets):
# DAILY_API_KEY=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_URL=
