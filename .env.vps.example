# Copie para .env na VPS: /opt/clinicapsi/.env
POSTGRES_USER=clinicapsi
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=clinicapsi

# Porta no host (Astra ja usa 80/443)
CLINICAPSI_HTTP_PORT=8080

PUBLIC_APP_URL=https://psiianasantos.com.br

# Admin opcional no boot (deixe vazio apos criar o usuario)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
# ADMIN_NAME=Administrador

# WhatsApp (opcional)
WHATSAPP_VERIFY_TOKEN=clinicapsi_webhook_token_2025
WHATSAPP_ACCESS_TOKEN=
