<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "PsyAll") — PsyAll | Plataforma digital de psicologia</title>

    <link rel="icon" type="image/png" href="~/images/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="192x192" href="~/images/psyall-icon.png" />
    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#1f7a4d" />
    <partial name="_BrandTheme" />

    @{
        var metaDescription = ViewData["MetaDescription"] as string
            ?? "PsyAll — plataforma digital que conecta pacientes a psicólogos com CRP ativo. Agende consultas online ou presenciais e avalie profissionais.";
        var canonical = ViewData["Canonical"] as string ?? "https://www.psiianasantos.com.br/";
    }
    <meta name="description" content="@metaDescription" />
    <meta name="keywords" content="PsyAll, psicologia online, psicólogo online, telepsicologia, agendar psicólogo, terapia online, plataforma psicologia, Londrina, CRP" />
    <meta name="author" content="PsyAll" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />
    <link rel="canonical" href="@canonical" />
    <meta name="language" content="Portuguese (Brazilian)" />

    <meta property="og:title" content="@(ViewData["Title"] ?? "PsyAll") — Plataforma digital de psicologia" />
    <meta property="og:description" content="@metaDescription" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="PsyAll" />
    <meta property="og:image" content="https://www.psiianasantos.com.br/images/psyall-logo.png" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="PsyAll — Psicologia digital" />
    <meta name="twitter:description" content="@metaDescription" />
    <meta name="twitter:image" content="https://www.psiianasantos.com.br/images/psyall-logo.png" />

    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "Organization",
      "name": "PsyAll",
      "alternateName": "PsyAll Psicologia",
      "url": "https://www.psiianasantos.com.br",
      "logo": "https://www.psiianasantos.com.br/images/psyall-logo.png",
      "description": "Plataforma digital que conecta pacientes e psicólogos para agendamento, teleconsulta e avaliações.",
      "address": {
        "@@type": "PostalAddress",
        "addressLocality": "Londrina",
        "addressRegion": "PR",
        "addressCountry": "BR"
      },
      "areaServed": "BR",
      "sameAs": []
    }
    </script>
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "WebSite",
      "name": "PsyAll",
      "url": "https://www.psiianasantos.com.br",
      "potentialAction": {
        "@@type": "SearchAction",
        "target": "https://www.psiianasantos.com.br/?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
    </script>

    <base href="~/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/brand-theme.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    <link href="ClinicaPsi.Web.styles.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" href="/" aria-label="PsyAll Psicologia">
                <img src="~/images/psyall-logo.png" alt="PsyAll" class="brand-logo-img" width="40" height="45" />
                <span class="brand-name"><span class="psy-brand-psy">Psy</span><span class="psy-brand-all">All</span></span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Início</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/#psicologos">Psicólogos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/ranking">Ranking</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/agendamento">Agendar</a>
                    </li>
                </ul>

                <ul class="navbar-nav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle me-1"></i>
                                @User.Identity.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                @if (User.IsInRole("Admin"))
                                {
                                    <li><a class="dropdown-item" href="/Admin">Área Admin</a></li>
                                }
                                @if (User.IsInRole("Psicologo"))
                                {
                                    <li><a class="dropdown-item" href="/Psicologo">Área Psicólogo</a></li>
                                }
                                @if (User.IsInRole("Cliente"))
                                {
                                    <li><a class="dropdown-item" href="/Cliente">Minha Área</a></li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="/Account/Logout">Sair</a></li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/Account/Login">Entrar</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Account/Register">Criar conta</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="py-5 mt-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <img src="~/images/psyall-logo.png" alt="" width="36" height="40" class="brand-logo-img" />
                        <h6 class="mb-0"><span class="psy-brand-psy">Psy</span><span class="psy-brand-all">All</span></h6>
                    </div>
                    <p class="small mb-0 opacity-75">
                        Plataforma digital para psicólogos e pacientes — agendamento, teleconsulta e avaliações.
                    </p>
                </div>
                <div class="col-md-4">
                    <h6 class="small text-uppercase opacity-75">Institucional</h6>
                    <p class="small mb-1"><a class="link-light link-underline-opacity-0" href="/termos/paciente">Termos — Pacientes</a></p>
                    <p class="small mb-1"><a class="link-light link-underline-opacity-0" href="/termos/psicologo">Termos — Psicólogos</a></p>
                    <p class="small mb-0"><a class="link-light link-underline-opacity-0" href="/ranking">Ranking</a></p>
                </div>
                <div class="col-md-4">
                    <h6 class="small text-uppercase opacity-75">Sede / suporte</h6>
                    <p class="small mb-0 opacity-75">
                        Londrina — PR<br />
                        Endereço administrativo da plataforma digital.<br />
                        Atendimento clínico conforme o profissional escolhido.
                    </p>
                </div>
            </div>
            <hr class="my-4 bg-light opacity-25">
            <p class="small mb-0 text-center opacity-75">
                &copy; @DateTime.Now.Year PsyAll — Todos os direitos reservados
            </p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <partial name="_ClienteChamadaNotifier" />
</body>
</html>
