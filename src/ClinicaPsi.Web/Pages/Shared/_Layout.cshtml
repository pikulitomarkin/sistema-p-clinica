<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @{
        var pageTitle = ViewData["Title"] as string ?? "PsyAll";
        var documentTitle = pageTitle.Contains("PsyAll", StringComparison.OrdinalIgnoreCase)
            ? pageTitle
            : $"{pageTitle} — PsyAll";
        if (string.IsNullOrWhiteSpace(ViewData["OgTitle"] as string))
        {
            ViewData["OgTitle"] = documentTitle;
        }
    }
    <title>@documentTitle</title>

    <link rel="icon" type="image/png" href="~/images/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="192x192" href="~/images/psyall-icon.png" />
    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#1f7a4d" />
    <partial name="_BrandTheme" />

    <meta name="keywords" content="PsyAll, psicologia online, psicólogo online, psicóloga online, telepsicologia, teleterapia, terapia online, preço social, plataforma psicologia, Londrina, Curitiba, Guarapuava, Cascavel, Paraná, CRP" />
    <meta name="author" content="PsyAll" />
    <partial name="_PublicSeoMeta" />

    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "Organization",
      "name": "PsyAll",
      "alternateName": "PsyAll Psicologia",
      "url": "https://psyall.com.br",
      "logo": "https://psyall.com.br/images/psyall-logo.png",
      "image": "https://psyall.com.br/images/psyall-logo.png",
      "description": "Plataforma digital que conecta pacientes e psicólogos para agendamento, teleterapia online a R$ 50 e avaliações. Sede administrativa em Londrina-PR; atendimento clínico 100% online.",
      "address": {
        "@@type": "PostalAddress",
        "addressLocality": "Londrina",
        "addressRegion": "PR",
        "addressCountry": "BR"
      },
      "areaServed": [
        { "@@type": "Country", "name": "BR" },
        { "@@type": "State", "name": "Paraná" },
        { "@@type": "City", "name": "Londrina" },
        { "@@type": "City", "name": "Curitiba" },
        { "@@type": "City", "name": "Guarapuava" },
        { "@@type": "City", "name": "Cascavel" }
      ],
      "knowsAbout": ["psicologia", "teleterapia", "telepsicologia", "psicóloga online", "saúde mental", "Paraná"],
      "sameAs": []
    }
    </script>
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "ProfessionalService",
      "name": "PsyAll Teleterapia",
      "url": "https://psyall.com.br",
      "image": "https://psyall.com.br/images/psyall-logo.png",
      "description": "Teleterapia digital a R$ 50 com psicólogos de CRP validado. Atendimento online para pacientes no Paraná (Londrina, Curitiba, Guarapuava, Cascavel) e no Brasil.",
      "provider": {
        "@@type": "Organization",
        "name": "PsyAll",
        "url": "https://psyall.com.br"
      },
      "areaServed": [
        { "@@type": "State", "name": "Paraná" },
        { "@@type": "City", "name": "Londrina" },
        { "@@type": "City", "name": "Curitiba" },
        { "@@type": "City", "name": "Guarapuava" },
        { "@@type": "City", "name": "Cascavel" },
        { "@@type": "Country", "name": "BR" }
      ],
      "serviceType": "Teleterapia / psicologia online",
      "priceRange": "R$50"
    }
    </script>
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "WebSite",
      "name": "PsyAll",
      "alternateName": "PsyAll Psicologia",
      "url": "https://psyall.com.br",
      "inLanguage": "pt-BR",
      "publisher": {
        "@@type": "Organization",
        "name": "PsyAll",
        "url": "https://psyall.com.br"
      }
    }
    </script>
    @await RenderSectionAsync("JsonLd", required: false)

    <base href="~/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/brand-theme.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/auth.css" rel="stylesheet" asp-append-version="true" />
    <link href="ClinicaPsi.Web.styles.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" href="/" aria-label="PsyAll Psicologia">
                <img src="~/images/psyall-logo.png" alt="PsyAll" class="brand-logo-img" width="40" height="45" />
                <span class="brand-name"><span class="psy-brand-psy">Psy</span><span class="psy-brand-all">All</span></span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                @{
                    var navPath = Context.Request.Path.Value ?? "/";
                    string NavClass(string href) =>
                        string.Equals(navPath, href, StringComparison.OrdinalIgnoreCase) ? "nav-link active" : "nav-link";
                }
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="@NavClass("/")" href="/">Início</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/#psicologos">Psicólogos</a>
                    </li>
                    <li class="nav-item">
                        <a class="@NavClass("/ranking")" href="/ranking">Ranking</a>
                    </li>
                    <li class="nav-item">
                        <a class="@NavClass("/agendamento")" href="/agendamento">Agendar</a>
                    </li>
                    <li class="nav-item">
                        <a class="@NavClass("/para-voce")" href="/para-voce">Para você</a>
                    </li>
                    <li class="nav-item">
                        <a class="@NavClass("/valor-social")" href="/valor-social">Valor social</a>
                    </li>
                    <li class="nav-item">
                        <a class="@NavClass("/privacidade")" href="/privacidade">Privacidade</a>
                    </li>
                </ul>

                <ul class="navbar-nav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle me-1"></i>
                                @User.Identity.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                @if (User.IsInRole("Admin"))
                                {
                                    <li><a class="dropdown-item" href="/Admin">Área Admin</a></li>
                                }
                                @if (User.IsInRole("Psicologo"))
                                {
                                    <li><a class="dropdown-item" href="/Psicologo">Área Psicólogo</a></li>
                                }
                                @if (User.IsInRole("Cliente"))
                                {
                                    <li><a class="dropdown-item" href="/Cliente">Minha Área</a></li>
                                }
                                <li><a class="dropdown-item" href="/privacidade/meus-dados">Meus dados (LGPD)</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="/Account/Logout">Sair</a></li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/Account/Login">Entrar</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Account/CriarConta">Criar conta</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="py-5 mt-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <img src="~/images/psyall-logo.png" alt="" width="36" height="40" class="brand-logo-img" />
                        <h6 class="mb-0"><span class="psy-brand-psy">Psy</span><span class="psy-brand-all">All</span></h6>
                    </div>
                    <p class="small mb-0 opacity-75">
                        Plataforma digital para psicólogos e pacientes — agendamento, teleconsulta e avaliações.
                        Teleterapia a R$&nbsp;50 para pacientes no Paraná e no Brasil.
                    </p>
                </div>
                <div class="col-md-3">
                    <h6 class="small text-uppercase opacity-75">Institucional</h6>
                    <p class="small mb-1"><a class="link-light link-underline-opacity-0" href="/para-voce">Para você (pacientes)</a></p>
                    <p class="small mb-1"><a class="link-light link-underline-opacity-0" href="/valor-social">Valor social (R$ 50)</a></p>
                    <p class="small mb-1"><a class="link-light link-underline-opacity-0" href="/privacidade">Política de Privacidade</a></p>
                    <p class="small mb-1"><a class="link-light link-underline-opacity-0" href="/termos/paciente">Termos — Pacientes</a></p>
                    <p class="small mb-1"><a class="link-light link-underline-opacity-0" href="/termos/psicologo">Termos — Psicólogos</a></p>
                    <p class="small mb-0"><a class="link-light link-underline-opacity-0" href="/ranking">Ranking</a></p>
                </div>
                <div class="col-md-3">
                    <h6 class="small text-uppercase opacity-75">Atendimento em</h6>
                    <p class="small mb-1 opacity-75">Teleterapia digital no Paraná:</p>
                    <p class="small mb-1"><a class="link-light link-underline-opacity-0" href="/psicologia-parana">Paraná (hub)</a></p>
                    <p class="small mb-1"><a class="link-light link-underline-opacity-0" href="/psicologia-londrina">Londrina</a></p>
                    <p class="small mb-1"><a class="link-light link-underline-opacity-0" href="/psicologia-curitiba">Curitiba</a></p>
                    <p class="small mb-1"><a class="link-light link-underline-opacity-0" href="/psicologia-guarapuava">Guarapuava</a></p>
                    <p class="small mb-0"><a class="link-light link-underline-opacity-0" href="/psicologia-cascavel">Cascavel</a></p>
                </div>
                <div class="col-md-2">
                    <h6 class="small text-uppercase opacity-75">Sede / suporte</h6>
                    <p class="small mb-0 opacity-75">
                        Londrina — PR<br />
                        Endereço administrativo da plataforma digital.<br />
                        Atendimento clínico online (teleterapia).
                    </p>
                </div>
            </div>
            <hr class="my-4 bg-light opacity-25">
            <p class="small mb-0 text-center opacity-75">
                &copy; @DateTime.Now.Year PsyAll — Todos os direitos reservados
            </p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <partial name="_ClienteChamadaNotifier" />
    <partial name="_CookieConsent" />
</body>
</html>
