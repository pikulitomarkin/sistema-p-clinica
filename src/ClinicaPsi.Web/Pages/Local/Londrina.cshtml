    ViewData["Canonical"] = "https://psyall.com.br/psicologia-londrina";
    ViewData["OgTitle"] = "Psicóloga online em Londrina | Teleterapia PsyAll";
    ViewData["LocalCitySlug"] = "londrina";
}

@section JsonLd {
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "ProfessionalService",
  "name": "PsyAll — Psicologia online em Londrina",
  "url": "https://psyall.com.br/psicologia-londrina",
  "image": "https://psyall.com.br/images/psyall-logo.png",
  "description": "Plataforma digital de teleterapia PsyAll para pacientes em Londrina-PR. Consultas online a R$ 50 com psicólogos de CRP validado.",
  "provider": {
    "@@type": "Organization",
    "name": "PsyAll",
    "url": "https://psyall.com.br"
  },
  "areaServed": {
    "@@type": "City",
    "name": "Londrina",
    "containedInPlace": {
      "@@type": "State",
      "name": "Paraná",
      "containedInPlace": { "@@type": "Country", "name": "BR" }
    }
  },
  "serviceType": "Teleterapia / psicologia online",
  "priceRange": "R$50"
}
</script>
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "BreadcrumbList",
  "itemListElement": [
    { "@@type": "ListItem", "position": 1, "name": "Início", "item": "https://psyall.com.br/" },
    { "@@type": "ListItem", "position": 2, "name": "Psicologia no Paraná", "item": "https://psyall.com.br/psicologia-parana" },
    { "@@type": "ListItem", "position": 3, "name": "Psicologia em Londrina", "item": "https://psyall.com.br/psicologia-londrina" }
  ]
}
</script>
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "FAQPage",
  "mainEntity": [
    {
      "@@type": "Question",
      "name": "Existe psicóloga online em Londrina pela PsyAll?",
      "acceptedAnswer": {
        "@@type": "Answer",
        "text": "Sim. A PsyAll oferece teleterapia digital para pacientes em Londrina-PR: você agenda com psicólogos de CRP validado e realiza a consulta por vídeo na plataforma, sem deslocamento até um consultório físico da marca."
      }
    },
    {
      "@@type": "Question",
      "name": "A PsyAll tem clínica física em Londrina?",
      "acceptedAnswer": {
        "@@type": "Answer",
        "text": "A sede administrativa da PsyAll fica em Londrina-PR. O atendimento clínico intermediado pela plataforma é exclusivamente online (teleterapia), com sala de vídeo integrada."
      }
    },
    {
      "@@type": "Question",
      "name": "Quanto custa a consulta online em Londrina?",
      "acceptedAnswer": {
        "@@type": "Answer",
        "text": "As consultas intermediadas pela PsyAll têm preço social padronizado de R$ 50,00."
      }
    }
  ]
}
</script>
