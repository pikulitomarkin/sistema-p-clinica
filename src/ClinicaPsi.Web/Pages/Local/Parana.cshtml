@page "/psicologia-parana"
@{
    ViewData["Title"] = "Psicologia online no Paraná | Teleterapia PsyAll";
    ViewData["MetaDescription"] = "Psicologia e psicóloga online no Paraná com a PsyAll: teleterapia digital a R$ 50 para Londrina, Curitiba, Guarapuava, Cascavel e outras cidades. Plataforma com CRP validado.";
    ViewData["Canonical"] = "https://psyall.com.br/psicologia-parana";
    ViewData["OgTitle"] = "Psicologia online no Paraná | Teleterapia PsyAll";
    ViewData["LocalCitySlug"] = "parana";
}

@section JsonLd {
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "ProfessionalService",
  "name": "PsyAll — Psicologia online no Paraná",
  "url": "https://psyall.com.br/psicologia-parana",
  "image": "https://psyall.com.br/images/psyall-logo.png",
  "description": "Plataforma digital de teleterapia PsyAll para pacientes no Paraná. Psicologia online a R$ 50 com psicólogos de CRP validado em Londrina, Curitiba, Guarapuava, Cascavel e outras cidades.",
  "provider": {
    "@@type": "Organization",
    "name": "PsyAll",
    "url": "https://psyall.com.br"
  },
  "areaServed": [
    {
      "@@type": "State",
      "name": "Paraná",
      "containedInPlace": { "@@type": "Country", "name": "BR" }
    },
    { "@@type": "City", "name": "Londrina" },
    { "@@type": "City", "name": "Curitiba" },
    { "@@type": "City", "name": "Guarapuava" },
    { "@@type": "City", "name": "Cascavel" }
  ],
  "serviceType": "Teleterapia / psicologia online",
  "priceRange": "R$50"
}
</script>
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "BreadcrumbList",
  "itemListElement": [
    { "@@type": "ListItem", "position": 1, "name": "Início", "item": "https://psyall.com.br/" },
    { "@@type": "ListItem", "position": 2, "name": "Psicologia no Paraná", "item": "https://psyall.com.br/psicologia-parana" }
  ]
}
</script>
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "FAQPage",
  "mainEntity": [
    {
      "@@type": "Question",
      "name": "A PsyAll atende psicologia online no Paraná?",
      "acceptedAnswer": {
        "@@type": "Answer",
        "text": "Sim. A PsyAll é uma plataforma digital de teleterapia com sede administrativa em Londrina-PR. Pacientes em cidades do Paraná — como Londrina, Curitiba, Guarapuava e Cascavel — podem agendar consultas online a R$ 50."
      }
    },
    {
      "@@type": "Question",
      "name": "As consultas no Paraná são presenciais?",
      "acceptedAnswer": {
        "@@type": "Answer",
        "text": "Não. Na PsyAll o atendimento clínico é somente por teleterapia, com sala de vídeo integrada. Não há clínicas físicas da marca em cada cidade."
      }
    },
    {
      "@@type": "Question",
      "name": "Quanto custa uma psicóloga online no Paraná pela PsyAll?",
      "acceptedAnswer": {
        "@@type": "Answer",
        "text": "O preço social padronizado é de R$ 50,00 por consulta intermediada pela plataforma."
      }
    }
  ]
}
</script>
}

<section class="psy-hero psy-mkt-hero">
    <div class="container psy-hero-inner">
        <div class="row align-items-center g-4">
            <div class="col-lg-8 psy-mkt-reveal">
                <p class="psy-eyebrow">PsyAll · Paraná</p>
                <h1 class="psy-hero-title psy-mkt-title-sm">
                    Psicologia online no Paraná
                </h1>
                <p class="psy-hero-lead">
                    A PsyAll é a <strong>plataforma digital de teleterapia</strong> com sede
                    administrativa em Londrina-PR. Pacientes em todo o <strong>Paraná</strong>
                    — incluindo Londrina, Curitiba, Guarapuava e Cascavel — agendam
                    psicologia online a <strong>R$&nbsp;50</strong>, com psicólogos de CRP validado.
                </p>
                <div class="d-flex flex-wrap gap-3 mt-4">
                    <a href="/Account/CriarConta" class="btn btn-psy-primary btn-lg">Criar conta</a>
                    <a href="/agendamento" class="btn btn-psy-ghost btn-lg">Agendar teleterapia</a>
                </div>
            </div>
            <div class="col-lg-4 text-center d-none d-lg-block psy-mkt-reveal psy-mkt-reveal-delay">
                <div class="psy-price-anchor" aria-hidden="true">
                    <span class="psy-price-anchor-label">Consulta online</span>
                    <span class="psy-price-anchor-value">R$&nbsp;50</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="psy-section">
    <div class="container">
        <partial name="_LocalCityNav" />
        <header class="psy-section-head psy-mkt-reveal mt-4">
            <h2>Atendimento digital por cidade</h2>
            <p>Páginas locais com o mesmo serviço honesto: teleterapia, não filiais físicas.</p>
        </header>
        <div class="row g-4 psy-city-cards">
            <div class="col-md-6 col-lg-3 psy-mkt-reveal">
                <a class="psy-city-card" href="/psicologia-londrina">
                    <span class="psy-city-card-label">Londrina</span>
                    <span class="psy-city-card-meta">Sede administrativa · teleterapia</span>
                </a>
            </div>
            <div class="col-md-6 col-lg-3 psy-mkt-reveal">
                <a class="psy-city-card" href="/psicologia-curitiba">
                    <span class="psy-city-card-label">Curitiba</span>
                    <span class="psy-city-card-meta">Psicologia online na capital</span>
                </a>
            </div>
            <div class="col-md-6 col-lg-3 psy-mkt-reveal">
                <a class="psy-city-card" href="/psicologia-guarapuava">
                    <span class="psy-city-card-label">Guarapuava</span>
                    <span class="psy-city-card-meta">Teleterapia a R$&nbsp;50</span>
                </a>
            </div>
            <div class="col-md-6 col-lg-3 psy-mkt-reveal">
                <a class="psy-city-card" href="/psicologia-cascavel">
                    <span class="psy-city-card-label">Cascavel</span>
                    <span class="psy-city-card-meta">Oeste do Paraná · online</span>
                </a>
            </div>
        </div>
    </div>
</section>

<section class="psy-section psy-section-alt">
    <div class="container">
        <header class="psy-section-head psy-mkt-reveal">
            <h2>O que a PsyAll oferece no Paraná</h2>
            <p>Marketplace clínico digital — agenda, vídeo, avaliações e preço social.</p>
        </header>
        <div class="psy-benefit-list">
            <article class="psy-benefit-row psy-mkt-reveal">
                <span class="psy-benefit-icon" aria-hidden="true"><i class="bi bi-camera-video"></i></span>
                <div>
                    <h3>Somente teleterapia</h3>
                    <p>
                        Todas as consultas intermediadas são online. Não há “clínica PsyAll”
                        presencial em cada município: o produto é a plataforma, com sala de vídeo integrada.
                    </p>
                </div>
            </article>
            <article class="psy-benefit-row psy-mkt-reveal">
                <span class="psy-benefit-icon" aria-hidden="true"><i class="bi bi-patch-check"></i></span>
                <div>
                    <h3>CRP validado antes de atender</h3>
                    <p>
                        Psicólogos enviam documentos e só ficam ativos após validação administrativa —
                        o mesmo padrão para pacientes em qualquer cidade paranaense.
                    </p>
                </div>
            </article>
            <article class="psy-benefit-row psy-mkt-reveal">
                <span class="psy-benefit-icon" aria-hidden="true"><i class="bi bi-cash-stack"></i></span>
                <div>
                    <h3>Preço social de R$&nbsp;50</h3>
                    <p>
                        Valor padronizado nas consultas da plataforma.
                        <a href="/valor-social">Entenda o valor social</a> e
                        <a href="/para-voce">os benefícios para pacientes</a>.
                    </p>
                </div>
            </article>
            <article class="psy-benefit-row psy-mkt-reveal">
                <span class="psy-benefit-icon" aria-hidden="true"><i class="bi bi-map"></i></span>
                <div>
                    <h3>Cobertura estadual com intenção local</h3>
                    <p>
                        As páginas de Londrina, Curitiba, Guarapuava e Cascavel explicam
                        o mesmo serviço digital no contexto de cada cidade — para quem busca
                        “psicóloga online” ou “clínica psicológica” com atendimento remoto.
                    </p>
                </div>
            </article>
        </div>
    </div>
</section>

<section class="psy-section" id="faq">
    <div class="container">
        <header class="psy-section-head psy-mkt-reveal">
            <h2>Perguntas frequentes — Paraná</h2>
        </header>
        <div class="psy-faq-list psy-mkt-reveal">
            <details class="psy-faq-item" open>
                <summary>A PsyAll atende só o Paraná?</summary>
                <p>
                    A sede administrativa é em Londrina-PR e priorizamos a comunicação local
                    no estado, mas a teleterapia digital pode atender pacientes em outras regiões do Brasil.
                </p>
            </details>
            <details class="psy-faq-item">
                <summary>Posso ser psicólogo e atender pela PsyAll no Paraná?</summary>
                <p>
                    Sim. Faça o <a href="/Account/RegisterPsicologo">cadastro de psicólogo</a>,
                    envie os documentos e aguarde a validação para ativar o perfil.
                </p>
            </details>
            <details class="psy-faq-item">
                <summary>Onde agendar?</summary>
                <p>
                    Em <a href="/agendamento">/agendamento</a> ou pela lista de
                    <a href="/#psicologos">psicólogos ativos na home</a>.
                </p>
            </details>
        </div>
    </div>
</section>

<section class="psy-section psy-cta">
    <div class="container text-center psy-mkt-reveal">
        <h2>Psicologia online no Paraná começa na PsyAll</h2>
        <p>Teleterapia a R$&nbsp;50 — escolha sua cidade ou vá direto ao cadastro.</p>
        <div class="d-flex flex-wrap gap-3 justify-content-center">
            <a href="/Account/CriarConta" class="btn btn-light btn-lg">Criar conta</a>
            <a href="/agendamento" class="btn btn-outline-light btn-lg">Agendar</a>
            <a href="/psicologia-londrina" class="btn btn-outline-light btn-lg">Londrina</a>
            <a href="/psicologia-curitiba" class="btn btn-outline-light btn-lg">Curitiba</a>
        </div>
    </div>
</section>
