@page "/Account/Logout"
@model LogoutModel
@{
    ViewData["Title"] = "Logout";
    ViewData["Robots"] = "noindex, nofollow";
    Layout = "_AuthLayout";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="auth-card">
                <div class="auth-card__header">
                    <div class="auth-icon"><i class="bi bi-box-arrow-right"></i></div>
                    <h1 class="auth-title">Sessão encerrada</h1>
                    <p class="auth-subtitle">Você saiu da PsyAll com segurança</p>
                </div>
                <div class="auth-card__body text-center">
                    <a href="/" class="btn btn-primary">
                        <i class="bi bi-house-door me-2"></i>
                        Voltar ao início
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>