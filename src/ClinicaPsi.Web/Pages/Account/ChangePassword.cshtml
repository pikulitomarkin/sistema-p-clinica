@page
@model ClinicaPsi.Web.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = Model.Obrigatorio ? "Trocar senha provisória — PsyAll" : "Alterar senha — PsyAll";
    ViewData["Robots"] = "noindex, nofollow";
    ViewData["AuthActionHref"] = "/";
    ViewData["AuthActionText"] = "Início";
    Layout = "_AuthLayout";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="auth-card">
            <div class="auth-card__header">
                <div class="auth-icon"><i class="bi bi-shield-lock"></i></div>
                <h1 class="auth-title">@(Model.Obrigatorio ? "Trocar senha provisória" : "Alterar senha")</h1>
                <p class="auth-subtitle">Sua conta PsyAll</p>
            </div>
            <div class="auth-card__body">
                @if (Model.Obrigatorio)
                {
                    <div class="alert alert-warning">
                        <i class="bi bi-shield-lock me-1"></i>Por segurança, troque a senha provisória antes de continuar.
                    </div>
                }
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="Input.SenhaAtual" class="form-label">Senha atual</label>
                        <input asp-for="Input.SenhaAtual" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.NovaSenha" class="form-label">Nova senha</label>
                        <input asp-for="Input.NovaSenha" class="form-control" />
                    </div>
                    <div class="mb-4">
                        <label asp-for="Input.ConfirmarSenha" class="form-label">Confirmar</label>
                        <input asp-for="Input.ConfirmarSenha" class="form-control" />
                    </div>
                    <button type="submit" class="auth-submit">Salvar nova senha</button>
                </form>
            </div>
        </div>
    </div>
</div>
