@page "/Account/Login"
@model LoginModel
@{
    ViewData["Title"] = "Login — PsyAll";
    ViewData["MetaDescription"] = "Acesse sua conta PsyAll.";
    ViewData["Canonical"] = "https://psyall.com.br/Account/Login";
    ViewData["Robots"] = "noindex, nofollow";
    ViewData["OgTitle"] = "Login — PsyAll";
    ViewData["AuthActionHref"] = "/";
    ViewData["AuthActionText"] = "Início";
    Layout = "_AuthLayout";
}

<div class="row justify-content-center">
    <div class="col-xl-7 col-lg-8">
        <div class="auth-card">
            <div class="auth-card__header">
                <div class="auth-icon"><i class="bi bi-person-circle"></i></div>
                <h1 class="auth-title">Acesso ao sistema</h1>
                <p class="auth-subtitle">Entre com suas credenciais para continuar</p>
            </div>
            <div class="auth-card__body">
                <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    }

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">
                            <i class="bi bi-envelope me-2"></i>Email
                        </label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="Digite seu email" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label">
                            <i class="bi bi-lock me-2"></i>Senha
                        </label>
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" placeholder="Digite sua senha" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="Input.RememberMe" class="form-check-input" />
                        <label asp-for="Input.RememberMe" class="form-check-label">Lembrar de mim</label>
                    </div>

                    <div class="mb-3 text-end">
                        <a asp-page="./ForgotPassword" class="auth-link">Esqueci a senha</a>
                    </div>

                    <button type="submit" class="auth-submit">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Entrar
                    </button>
                </form>
            </div>
            <div class="auth-card__footer">
                <small class="text-muted d-block mb-2">
                    <i class="bi bi-shield-check me-1"></i>Acesso protegido
                </small>
                <small>
                    Não tem conta?
                    <a href="/Account/CriarConta" class="auth-link">Criar conta</a>
                </small>
            </div>
        </div>
    </div>
</div>
