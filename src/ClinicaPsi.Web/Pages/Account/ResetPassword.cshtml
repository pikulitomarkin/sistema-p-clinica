@page
@model ClinicaPsi.Web.Pages.Account.ResetPasswordModel
@{ ViewData["Title"] = "Nova senha"; Layout = null; }
<!DOCTYPE html>
<html lang="pt-BR"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>@ViewData["Title"]</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
<style>body{min-height:100vh;background:linear-gradient(160deg,#e8f2ee,#f7f3ea);font-family:Georgia,serif}.card-auth{max-width:440px;margin:8vh auto;border:none;border-radius:12px;box-shadow:0 12px 40px rgba(47,111,94,.12)}.brand{color:#2F6F5E;font-weight:700}.btn-auth{background:#2F6F5E;color:#fff}</style>
</head><body><div class="container"><div class="card card-auth"><div class="card-body p-4 p-md-5">
<div class="text-center mb-4"><div class="brand fs-4">Psicóloga Ana Santos</div><p class="text-muted">Definir nova senha</p></div>
<form method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<input type="hidden" asp-for="Input.Code"/>
<div class="mb-3"><label asp-for="Input.Email" class="form-label">E-mail</label><input asp-for="Input.Email" class="form-control"/></div>
<div class="mb-3"><label asp-for="Input.Password" class="form-label">Nova senha</label><input asp-for="Input.Password" class="form-control"/></div>
<div class="mb-4"><label asp-for="Input.ConfirmPassword" class="form-label">Confirmar</label><input asp-for="Input.ConfirmPassword" class="form-control"/></div>
<button type="submit" class="btn btn-auth w-100">Salvar nova senha</button></form>
</div></div></div></body></html>
