@page
@model ClinicaPsi.Web.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Nova senha — PsyAll";
    ViewData["Robots"] = "noindex, nofollow";
    ViewData["AuthActionHref"] = "/Account/Login";
    ViewData["AuthActionText"] = "Voltar ao login";
    ViewData["AuthActionIcon"] = "bi-box-arrow-in-right";
    Layout = "_AuthLayout";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="auth-card">
            <div class="auth-card__header">
                <div class="auth-icon"><i class="bi bi-shield-lock"></i></div>
                <h1 class="auth-title">Definir nova senha</h1>
                <p class="auth-subtitle">Escolha uma senha para a sua conta</p>
            </div>
            <div class="auth-card__body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Input.Code" />
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">E-mail</label>
                        <input asp-for="Input.Email" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label">Nova senha</label>
                        <input asp-for="Input.Password" class="form-control" />
                    </div>
                    <div class="mb-4">
                        <label asp-for="Input.ConfirmPassword" class="form-label">Confirmar</label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" />
                    </div>
                    <button type="submit" class="auth-submit">Salvar nova senha</button>
                </form>
            </div>
        </div>
    </div>
</div>
