@page "/Account/Register"
@model RegisterModel
@{
    ViewData["Title"] = "Cadastro de paciente — PsyAll";
    ViewData["MetaDescription"] = "Cadastre-se como paciente na PsyAll e agende teleterapia com psicólogos de CRP validado. Consultas a R$ 50.";
    ViewData["Canonical"] = "https://psyall.com.br/Account/Register";
    ViewData["OgTitle"] = "Cadastro de paciente — PsyAll";
    ViewData["AuthActionHref"] = "/Account/Login";
    ViewData["AuthActionText"] = "Já tenho conta";
    ViewData["AuthActionIcon"] = "bi-box-arrow-in-right";
    Layout = "_AuthLayout";
}

<style>

        .register-container {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            box-shadow: 0 18px 48px var(--brand-shadow);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            overflow: hidden;
        }

        .register-header {
            background: var(--brand-gradient-soft);
            padding: 2rem;
            text-align: center;
            position: relative;
        }

        .register-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse"><path d="M 10 0 L 0 0 0 10" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="0.5"/></pattern></defs><rect width="100" height="100" fill="url(%23grid)"/></svg>');
            opacity: 0.3;
        }

        .register-icon {
            width: 80px;
            height: 80px;
            background: var(--brand-gradient-chip);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            color: var(--brand-primary);
            margin: 0 auto 1rem;
            backdrop-filter: blur(10px);
            border: 2px solid var(--brand-border);
        }

        .register-title {
            color: var(--brand-ink);
            font-weight: 700;
            font-size: 1.5rem;
            margin-bottom: 0.5rem;
            position: relative;
            z-index: 2;
        }

        .register-subtitle {
            color: rgba(255, 255, 255, 0.85);
            font-size: 0.95rem;
            margin-bottom: 0;
            position: relative;
            z-index: 2;
        }

        .register-

        .form-control {
            border: 2px solid #e9ecef;
            border-radius: 10px;
            padding: 0.75rem 1rem;
            background: #f8f9fa;
            color: var(--brand-ink);
            transition: all 0.3s ease;
            margin-bottom: 1rem;
            font-size: 0.95rem;
        }

        .form-control:focus {
            border-color: var(--brand-primary);
            box-shadow: 0 0 0 0.2rem rgba(var(--brand-primary-rgb), 0.18);
            background: white;
        }

        .form-label {
            color: var(--brand-ink);
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .register-btn {
            background: var(--brand-gradient);
            border: none;
            border-radius: 10px;
            padding: 0.875rem 2rem;
            color: white;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.3s ease;
            width: 100%;
            margin-top: 1rem;
        }

        .register-btn:hover {
            background: var(--brand-gradient);
            transform: translateY(-2px);
            box-shadow: 0 10px 25px var(--brand-shadow);
            color: white;
        }

        .register-btn:disabled {
            background: #ccc;
            cursor: not-allowed;
            transform: none;
        }

        .login-link {
            color: var(--brand-primary);
            text-decoration: none;
            font-weight: 600;
        }

        .login-link:hover {
            color: #20c997;
            text-decoration: underline;
        }

        .register-footer {
            background: #f8f9fa;
            padding: 1.5rem;
            text-align: center;
            border-top: 1px solid #e9ecef;
        }

        .navbar-brand {
            color: var(--brand-ink) !important;
            text-decoration: none;
            font-weight: 700;
            font-size: 1.2rem;
        }

        .top-navbar {
            background: var(--brand-gradient-nav);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--brand-border);
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1030;
        }

        .btn-outline-success {
            color: white;
            border-color: white;
        }

        .btn-outline-success:hover {
            background: rgba(255, 255, 255, 0.1);
            color: white;
        }

        .error-message {
            color: #dc3545;
            font-size: 0.875rem;
            margin-top: 0.25rem;
        }

        /* Evita caixa vermelha vazia quando não há erros de validação */
        .validation-summary-valid {
            display: none;
        }

        .alert.alert-danger.validation-summary-errors:empty {
            display: none;
        }

        .password-strength {
            font-size: 0.85rem;
            margin-top: 0.5rem;
        }

        .strength-weak {
            color: #dc3545;
        }

        .strength-medium {
            color: #ffc107;
        }

        .strength-strong {
            color: var(--brand-primary);
        }

        @@media (max-width: 768px) {
            .register-
        }

        @@media (max-width: 480px) {
            .register-icon {
                width: 60px;
                height: 60px;
                font-size: 1.5rem;
            }

            .register-title {
                font-size: 1.25rem;
            }

            .register-
        }
    </style>
<!-- Top Navigation --><div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-5 col-lg-6 col-md-8">
                <div class="register-container">
                    <div class="register-header">
                        <div class="register-icon">
                            <i class="bi bi-person-plus"></i>
                        </div>
                        <h1 class="register-title">Criar Conta</h1>
                        <p class="register-subtitle">Preencha os dados para se registrar</p>
                    </div>

                    <div class="register-body">
                        <form method="post">
                            @if (!ViewData.ModelState.IsValid)
                            {
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                            }

                            <div class="mb-3">
                                <label asp-for="Input.Nome" class="form-label">Nome Completo</label>
                                <input asp-for="Input.Nome" class="form-control" placeholder="Seu nome completo" />
                                <span asp-validation-for="Input.Nome" class="error-message"></span>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="Input.CPF" class="form-label">CPF</label>
                                        <input asp-for="Input.CPF" class="form-control" placeholder="12345678901" maxlength="11" />
                                        <span asp-validation-for="Input.CPF" class="error-message"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="Input.DataNascimento" class="form-label">Data de Nascimento</label>
                                        <input asp-for="Input.DataNascimento" class="form-control" type="date" />
                                        <span asp-validation-for="Input.DataNascimento" class="error-message"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Input.Email" class="form-label">Email</label>
                                <input asp-for="Input.Email" class="form-control" type="email" placeholder="seu@email.com" />
                                <span asp-validation-for="Input.Email" class="error-message"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Input.PhoneNumber" class="form-label">Telefone (WhatsApp)</label>
                                <input asp-for="Input.PhoneNumber" class="form-control" placeholder="(42) 9 9999-9999" />
                                <span asp-validation-for="Input.PhoneNumber" class="error-message"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Input.Password" class="form-label">Senha</label>
                                <input asp-for="Input.Password" class="form-control" type="password" placeholder="Crie uma senha segura" />
                                <span asp-validation-for="Input.Password" class="error-message"></span>
                                <small class="password-strength">
                                    <i class="bi bi-info-circle me-1"></i>
                                    Mínimo 6 caracteres, incluindo números e letras
                                </small>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Input.ConfirmPassword" class="form-label">Confirmar Senha</label>
                                <input asp-for="Input.ConfirmPassword" class="form-control" type="password" placeholder="Repita sua senha" />
                                <span asp-validation-for="Input.ConfirmPassword" class="error-message"></span>
                            </div>

                            <div class="mb-3 form-check">
                                <input asp-for="Input.AceiteTermos" class="form-check-input" />
                                <label asp-for="Input.AceiteTermos" class="form-check-label">
                                    Li e aceito os <a href="/termos/paciente" target="_blank" rel="noopener">Termos de Uso para pacientes</a>
                                </label>
                                <span asp-validation-for="Input.AceiteTermos" class="error-message d-block"></span>
                            </div>

                            <div class="mb-3 form-check">
                                <input asp-for="Input.AceitePrivacidade" class="form-check-input" />
                                <label asp-for="Input.AceitePrivacidade" class="form-check-label">
                                    Li e aceito a <a href="/privacidade" target="_blank" rel="noopener">Política de Privacidade</a> (LGPD)
                                </label>
                                <span asp-validation-for="Input.AceitePrivacidade" class="error-message d-block"></span>
                            </div>

                            <div class="mb-3 form-check">
                                <input asp-for="Input.ConsentimentoDadosSaude" class="form-check-input" />
                                <label asp-for="Input.ConsentimentoDadosSaude" class="form-check-label">
                                    Consinto o tratamento de dados de saúde / sensíveis necessários ao atendimento psicológico na plataforma, nos termos da LGPD
                                </label>
                                <span asp-validation-for="Input.ConsentimentoDadosSaude" class="error-message d-block"></span>
                            </div>

                            <button type="submit" class="register-btn">
                                <i class="bi bi-check-circle me-2"></i>
                                Criar Conta
                            </button>
                        </form>
                    </div>

                    <div class="register-footer">
                        <small>
                            Já tem conta?
                            <a asp-page="./Login" class="login-link">Faça login aqui</a>
                            <br />
                            <a href="/Account/CriarConta" class="login-link">Escolher outro perfil</a>
                            <br />
                            <a href="/privacidade" class="login-link">Política de Privacidade</a>
                            ·
                            <a href="/termos/paciente" class="login-link">Termos</a>
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
<script>
        document.addEventListener('DOMContentLoaded', function() {
            const registerContainer = document.querySelector('.register-container');
            registerContainer.style.opacity = '0';
            registerContainer.style.transform = 'translateY(30px)';
            setTimeout(function() {
                registerContainer.style.transition = 'all 0.6s ease';
                registerContainer.style.opacity = '1';
                registerContainer.style.transform = 'translateY(0)';
            }, 100);
        });
    </script>
