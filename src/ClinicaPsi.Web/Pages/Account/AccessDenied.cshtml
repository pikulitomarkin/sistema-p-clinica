@page
@model ClinicaPsi.Web.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Acesso negado";
    ViewData["Robots"] = "noindex, nofollow";
    ViewData["Canonical"] = "https://psyall.com.br/Account/AccessDenied";
    ViewData["AuthActionHref"] = "/";
    ViewData["AuthActionText"] = "Início";
    Layout = "_AuthLayout";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="auth-card">
            <div class="auth-card__header">
                <div class="auth-icon"><i class="bi bi-shield-exclamation"></i></div>
                <h1 class="auth-title">Acesso negado</h1>
                <p class="auth-subtitle">Esta conta não tem permissão para abrir esta página.</p>
            </div>
            <div class="auth-card__body">
                <p class="text-muted text-center mb-4">
                    Entre com o perfil correto ou volte para a área em que você já está autenticado.
                </p>
                <div class="d-grid gap-2">
                    <a href="javascript:history.back()" class="btn btn-outline-primary">
                        <i class="bi bi-arrow-left me-2"></i>Voltar
                    </a>
                    <a href="/Account/Login" class="btn btn-primary">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Fazer login
                    </a>
                    <a href="/" class="btn btn-outline-secondary">
                        <i class="bi bi-house me-2"></i>Página inicial
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
