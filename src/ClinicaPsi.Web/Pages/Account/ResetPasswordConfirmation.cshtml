@page
@{ ViewData["Title"] = "Senha redefinida"; Layout = null; }
<!DOCTYPE html>
<html lang="pt-BR"><head><meta charset="utf-8"/><title>@ViewData["Title"]</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
<style>body{min-height:100vh;background:linear-gradient(160deg,#e8f2ee,#f7f3ea);font-family:Georgia,serif}.card-auth{max-width:440px;margin:8vh auto;border:none;border-radius:12px;box-shadow:0 12px 40px rgba(47,111,94,.12)}.brand{color:#2F6F5E;font-weight:700}.btn-auth{background:#2F6F5E;color:#fff}</style>
</head><body><div class="container"><div class="card card-auth"><div class="card-body p-5 text-center">
<div class="brand fs-4 mb-3">Psicóloga Ana Santos</div>
