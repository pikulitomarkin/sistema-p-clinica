@page
@{
    ViewData["Title"] = "Senha redefinida — PsyAll";
    ViewData["Robots"] = "noindex, nofollow";
    ViewData["AuthActionHref"] = "/Account/Login";
    ViewData["AuthActionText"] = "Ir para o login";
    ViewData["AuthActionIcon"] = "bi-box-arrow-in-right";
    Layout = "_AuthLayout";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="auth-card">
            <div class="auth-card__body text-center py-5">
                <div class="auth-icon"><i class="bi bi-check2-circle"></i></div>
                <h1 class="auth-title">Senha redefinida</h1>
                <p class="auth-subtitle mb-4">Sua senha foi atualizada. Você já pode entrar.</p>
                <a href="/Account/Login" class="auth-submit d-inline-flex justify-content-center align-items-center" style="width:auto;padding-inline:1.5rem;">Ir para o login</a>
            </div>
        </div>
    </div>
</div>
