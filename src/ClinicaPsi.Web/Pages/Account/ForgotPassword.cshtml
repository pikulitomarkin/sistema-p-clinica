@page
@model ClinicaPsi.Web.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Esqueci a senha — PsyAll";
    ViewData["Robots"] = "noindex, nofollow";
    ViewData["AuthActionHref"] = "/Account/Login";
    ViewData["AuthActionText"] = "Voltar ao login";
    ViewData["AuthActionIcon"] = "bi-box-arrow-in-right";
    Layout = "_AuthLayout";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="auth-card">
            <div class="auth-card__header">
                <div class="auth-icon"><i class="bi bi-key"></i></div>
                <h1 class="auth-title">Redefinir senha</h1>
                <p class="auth-subtitle">Informe o e-mail da sua conta PsyAll</p>
            </div>
            <div class="auth-card__body">
                @if (Model.EmailEnviado)
                {
                    <div class="alert alert-success mb-0">Se o e-mail existir em nossa base, enviamos um link para redefinir a senha.</div>
                }
                else
                {
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label">E-mail cadastrado</label>
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" />
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>
                        <button type="submit" class="auth-submit">Enviar link</button>
                    </form>
                }
            </div>
            <div class="auth-card__footer">
                <a asp-page="./Login" class="auth-link">Voltar ao login</a>
            </div>
        </div>
    </div>
</div>
