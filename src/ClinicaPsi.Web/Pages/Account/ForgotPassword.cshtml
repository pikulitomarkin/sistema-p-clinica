@page
@model ClinicaPsi.Web.Pages.Account.ForgotPasswordModel
@{ ViewData["Title"] = "Esqueci a senha"; Layout = null; }
<!DOCTYPE html>
<html lang="pt-BR"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>@ViewData["Title"] — Psicóloga Ana Santos</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
<style>body{min-height:100vh;background:linear-gradient(160deg,#e8f2ee,#f7f3ea 55%,#dfe9e4);font-family:Georgia,serif}.card-auth{max-width:440px;margin:8vh auto;border:none;border-radius:12px;box-shadow:0 12px 40px rgba(47,111,94,.12)}.brand{color:#2F6F5E;font-weight:700}.btn-auth{background:#2F6F5E;border-color:#2F6F5E;color:#fff}</style>
</head><body><div class="container"><div class="card card-auth"><div class="card-body p-4 p-md-5">
<div class="text-center mb-4"><div class="brand fs-4">Psicóloga Ana Santos</div><p class="text-muted mb-0">Redefinir senha</p></div>
@if (Model.EmailEnviado){<div class="alert alert-success">Se o e-mail existir em nossa base, enviamos um link para redefinir a senha.</div><div class="text-center"><a asp-page="./Login" class="btn btn-auth">Voltar ao login</a></div>}
else{<form method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="mb-3"><label asp-for="Input.Email" class="form-label">E-mail cadastrado</label><input asp-for="Input.Email" class="form-control" autocomplete="username"/><span asp-validation-for="Input.Email" class="text-danger"></span></div>
<button type="submit" class="btn btn-auth w-100 mb-3">Enviar link</button>
<div class="text-center"><a asp-page="./Login" style="color:#2F6F5E">Voltar ao login</a></div></form>}
</div></div></div></body></html>
