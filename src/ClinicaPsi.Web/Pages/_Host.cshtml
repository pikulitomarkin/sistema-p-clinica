@page "/"
@model ClinicaPsi.Web.Pages._HostModel
@{
    ViewData["Title"] = "PsyAll — Plataforma digital de psicologia";
    ViewData["MetaDescription"] = "PsyAll é a plataforma digital que conecta pacientes a psicólogos com CRP ativo. Agende consultas online ou presenciais, avalie profissionais e encontre o atendimento certo para você.";
    ViewData["Canonical"] = "https://psyall.com.br/";
    var clinica = Model.Clinica;
}

<section class="psy-hero">
    <div class="container psy-hero-inner">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <p class="psy-eyebrow">Plataforma digital de psicologia</p>
                <h1 class="psy-hero-title">
                    <span class="psy-brand-psy">Psy</span><span class="psy-brand-all">All</span>
                </h1>
                <p class="psy-hero-lead">
                    Conecte-se a psicólogos ativos, agende consultas e cuide da saúde mental
                    com transparência, avaliações e atendimento online ou presencial.
                </p>
                <div class="d-flex flex-wrap gap-3 mt-4">
                    <a href="#psicologos" class="btn btn-psy-primary btn-lg">
                        Ver psicólogos
                    </a>
                    <a href="/Account/CriarConta" class="btn btn-psy-ghost btn-lg">
                        Criar conta gratuita
                    </a>
                </div>
                <p class="psy-hero-note mt-3 mb-0">
                    Sede administrativa em Londrina-PR — atendimento digital em todo o Brasil.
                </p>
            </div>
            <div class="col-lg-5 text-center">
                <img src="~/images/psyall-logo.png"
                     alt="PsyAll Psicologia"
                     class="psy-hero-logo img-fluid"
                     width="320" height="360" />
            </div>
        </div>
    </div>
</section>

<section class="psy-section" id="como-funciona">
    <div class="container">
        <header class="psy-section-head">
            <h2>Como a PsyAll funciona</h2>
            <p>Marketplace clínico com a estrutura completa de agenda, prontuário e consulta online.</p>
        </header>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="psy-step">
                    <span class="psy-step-num">1</span>
                    <h3>Escolha o profissional</h3>
                    <p>Veja CRP, especialidades, avaliações e disponibilidade dos psicólogos ativos.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="psy-step">
                    <span class="psy-step-num">2</span>
                    <h3>Agende com segurança</h3>
                    <p>Marque consulta online ou presencial. Confirmações e sala de vídeo na plataforma.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="psy-step">
                    <span class="psy-step-num">3</span>
                    <h3>Avalie a experiência</h3>
                    <p>Após a consulta, paciente e psicólogo podem avaliar — o ranking destaca os melhores.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="psy-section psy-section-alt" id="psicologos">
    <div class="container">
        <header class="psy-section-head">
            <h2>Psicólogos ativos</h2>
            <p>Profissionais com perfil ativo na PsyAll — escolha e agende.</p>
        </header>

        @if (!Model.Psicologos.Any())
        {
            <div class="psy-empty">
                <p class="mb-0">Em breve novos psicólogos estarão disponíveis. Cadastre-se como paciente ou profissional.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var psi in Model.Psicologos)
                {
                    <div class="col-md-6 col-lg-4">
                        <article class="psy-pro-card">
                            <div class="psy-pro-top">
                                @if (!string.IsNullOrWhiteSpace(psi.FotoUrl))
                                {
                                    <img src="@psi.FotoUrl" alt="Foto de @psi.Nome" class="psy-pro-avatar" width="72" height="72" />
                                }
                                else
                                {
                                    <div class="psy-pro-avatar psy-pro-avatar-fallback" aria-hidden="true">
                                        @(psi.Nome.Length > 0 ? psi.Nome[0].ToString().ToUpperInvariant() : "?")
                                    </div>
                                }
                                <div>
                                    <h3 class="psy-pro-name">@psi.Nome</h3>
                                    <p class="psy-pro-crp mb-0">CRP @psi.CRP</p>
                                </div>
                            </div>
                            <p class="psy-pro-specs">
                                @(string.IsNullOrWhiteSpace(psi.Especialidades) ? "Psicologia clínica" : psi.Especialidades)
                            </p>
                            <div class="psy-pro-meta">
                                <span class="psy-stars" title="@psi.AvaliacaoMedia.ToString("0.0") de 5">
                                    @for (var i = 1; i <= 5; i++)
                                    {
                                        <i class="bi @(i <= Math.Round(psi.AvaliacaoMedia) ? "bi-star-fill" : "bi-star")"></i>
                                    }
                                    @if (psi.TotalAvaliacoes > 0)
                                    {
                                        <span class="psy-stars-label">@psi.AvaliacaoMedia.ToString("0.0") (@psi.TotalAvaliacoes)</span>
                                    }
                                    else
                                    {
                                        <span class="psy-stars-label">Sem avaliações</span>
                                    }
                                </span>
                            </div>
                            <div class="psy-pro-actions">
                                <a class="btn btn-psy-primary w-100"
                                   href="@(User.Identity?.IsAuthenticated == true ? $"/Cliente/AgendarConsulta?psicologoId={psi.Id}" : "/Account/Login?returnUrl=/Cliente/AgendarConsulta?psicologoId=" + psi.Id)">
                                    Agendar
                                </a>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </div>
</section>

<section class="psy-section" id="ranking">
    <div class="container">
        <header class="psy-section-head">
            <h2>Ranking dos mais bem avaliados</h2>
            <p>Atualizado com base nas avaliações públicas de pacientes após consultas realizadas.</p>
        </header>

        @if (!Model.Ranking.Any())
        {
            <div class="psy-empty">
                <p class="mb-0">O ranking aparece assim que houver avaliações de consultas realizadas.</p>
            </div>
        }
        else
        {
            <ol class="psy-rank-list">
                @for (var i = 0; i < Model.Ranking.Count; i++)
                {
                    var psi = Model.Ranking[i];
                    <li class="psy-rank-item">
                        <span class="psy-rank-pos">@(i + 1)</span>
                        <div class="psy-rank-info">
                            <strong>@psi.Nome</strong>
                            <span>CRP @psi.CRP</span>
                        </div>
                        <div class="psy-rank-score">
                            <i class="bi bi-star-fill"></i>
                            @psi.AvaliacaoMedia.ToString("0.0")
                            <small>(@psi.TotalAvaliacoes)</small>
                        </div>
                    </li>
                }
            </ol>
            <div class="text-center mt-4">
                <a href="/ranking" class="btn btn-psy-ghost">Ver ranking completo</a>
            </div>
        }
    </div>
</section>

<section class="psy-section psy-section-alt" id="para-quem">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="psy-audience">
                    <h2>Para pacientes</h2>
                    <p>Encontre psicólogos, agende, entre na sala online e avalie o atendimento.</p>
                    <ul>
                        <li>Perfis com CRP e especialidades</li>
                        <li>Histórico e documentos na sua área</li>
                        <li>Avaliação após cada consulta realizada</li>
                    </ul>
                    <a href="/Account/Register" class="btn btn-psy-primary">Sou paciente</a>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="psy-audience">
                    <h2>Para psicólogos</h2>
                    <p>Gerencie agenda, prontuário, teleconsulta e construa reputação com avaliações.</p>
                    <ul>
                        <li>Agenda e sala de vídeo integradas</li>
                        <li>Prontuário e documentos clínicos</li>
                        <li>Ranking público por avaliação</li>
                    </ul>
                    <a href="/Account/RegisterPsicologo" class="btn btn-psy-primary">Sou psicólogo — cadastrar</a>
                    <a href="/Account/Login" class="btn btn-psy-ghost ms-2">Já tenho conta</a>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="psy-section" id="contato">
    <div class="container">
        <header class="psy-section-head">
            <h2>Contato e sede</h2>
            <p>
                A PsyAll é uma <strong>plataforma digital</strong> para psicólogos e pacientes.
                O endereço abaixo é da sede administrativa / apoio presencial quando aplicável — não substitui o consultório de cada profissional.
            </p>
        </header>
        <div class="row g-4 justify-content-center">
            <div class="col-lg-8">
                <div class="psy-contact">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <h3><i class="bi bi-geo-alt"></i> Endereço</h3>
                            <p style="white-space: pre-line;">@(clinica.Endereco)</p>
                        </div>
                        <div class="col-md-6">
                            <h3><i class="bi bi-telephone"></i> Telefone</h3>
                            <p>@(clinica.Telefone)</p>
                            <h3><i class="bi bi-envelope"></i> E-mail</h3>
                            <p>@(clinica.Email)</p>
                            <h3><i class="bi bi-clock"></i> Horários de suporte</h3>
                            <p>@(clinica.HorarioFuncionamento)</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="psy-section psy-cta">
    <div class="container text-center">
        <h2>Pronto para começar?</h2>
        <p>Crie sua conta e acesse psicólogos ativos na PsyAll.</p>
        <div class="d-flex flex-wrap gap-3 justify-content-center">
            <a href="/Account/CriarConta" class="btn btn-light btn-lg">Criar conta</a>
            <a href="/privacidade" class="btn btn-outline-light btn-lg">Privacidade</a>
            <a href="/termos/paciente" class="btn btn-outline-light btn-lg">Termos do paciente</a>
            <a href="/termos/psicologo" class="btn btn-outline-light btn-lg">Termos do psicólogo</a>
        </div>
    </div>
</section>
