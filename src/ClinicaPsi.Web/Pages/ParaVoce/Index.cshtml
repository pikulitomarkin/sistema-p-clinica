@page "/para-voce"
@{
    ViewData["Title"] = "Para você | Benefícios PsyAll para pacientes";
    ViewData["MetaDescription"] = "Descubra os benefícios de usar a PsyAll como paciente: psicólogos com CRP validado, teleconsulta, avaliações, histórico e plataforma alinhada à LGPD.";
    ViewData["Canonical"] = "https://psyall.com.br/para-voce";
}

<section class="psy-hero psy-mkt-hero">
    <div class="container psy-hero-inner">
        <div class="row align-items-center g-4">
            <div class="col-lg-7 psy-mkt-reveal">
                <p class="psy-eyebrow">PsyAll para pacientes</p>
                <h1 class="psy-hero-title">
                    <span class="psy-brand-psy">Psy</span><span class="psy-brand-all">All</span>
                </h1>
                <p class="psy-hero-lead">
                    Cuidar da saúde mental fica mais simples: escolha psicólogos validados,
                    agende online ou presencial e acompanhe tudo em um só lugar.
                </p>
                <div class="d-flex flex-wrap gap-3 mt-4">
                    <a href="/Account/CriarConta" class="btn btn-psy-primary btn-lg">Criar conta gratuita</a>
                    <a href="/#psicologos" class="btn btn-psy-ghost btn-lg">Ver psicólogos</a>
                </div>
            </div>
            <div class="col-lg-5 text-center psy-mkt-reveal psy-mkt-reveal-delay">
                <img src="~/images/psyall-logo.png"
                     alt="PsyAll — plataforma de psicologia"
                     class="psy-hero-logo img-fluid"
                     width="280" height="315" />
            </div>
        </div>
    </div>
</section>

<section class="psy-section" id="beneficios">
    <div class="container">
        <header class="psy-section-head psy-mkt-reveal">
            <h2>Por que escolher a PsyAll</h2>
            <p>Benefícios pensados para quem busca atendimento psicológico com transparência.</p>
        </header>

        <div class="psy-benefit-list">
            <article class="psy-benefit-row psy-mkt-reveal">
                <span class="psy-benefit-icon" aria-hidden="true"><i class="bi bi-shield-check"></i></span>
                <div>
                    <h3>Psicólogos com CRP validado</h3>
                    <p>
                        Profissionais passam por validação administrativa com documentos
                        (CNH e carteira CRP) antes de atender na plataforma.
                    </p>
                </div>
            </article>
            <article class="psy-benefit-row psy-mkt-reveal">
                <span class="psy-benefit-icon" aria-hidden="true"><i class="bi bi-camera-video"></i></span>
                <div>
                    <h3>Teleconsulta ou presencial</h3>
                    <p>
                        Agende no formato que fizer sentido para você. Na consulta online,
                        a sala de vídeo fica integrada à PsyAll — sem app extra obrigatório.
                    </p>
                </div>
            </article>
            <article class="psy-benefit-row psy-mkt-reveal">
                <span class="psy-benefit-icon" aria-hidden="true"><i class="bi bi-star"></i></span>
                <div>
                    <h3>Avaliações reais após a consulta</h3>
                    <p>
                        Depois do atendimento realizado, você pode avaliar o profissional.
                        O ranking público destaca quem entrega boa experiência.
                    </p>
                </div>
            </article>
            <article class="psy-benefit-row psy-mkt-reveal">
                <span class="psy-benefit-icon" aria-hidden="true"><i class="bi bi-journal-text"></i></span>
                <div>
                    <h3>Histórico e área do paciente</h3>
                    <p>
                        Consulte suas consultas, acompanhe o andamento e mantenha o
                        histórico organizado na sua conta.
                    </p>
                </div>
            </article>
            <article class="psy-benefit-row psy-mkt-reveal">
                <span class="psy-benefit-icon" aria-hidden="true"><i class="bi bi-lock"></i></span>
                <div>
                    <h3>Plataforma alinhada à LGPD</h3>
                    <p>
                        Dados tratados com política de privacidade clara, cookies com escolha
                        e canal para exercer direitos do titular.
                        <a href="/privacidade">Ver privacidade</a>.
                    </p>
                </div>
            </article>
        </div>
    </div>
</section>

<section class="psy-section psy-section-alt" id="como-usar">
    <div class="container">
        <header class="psy-section-head psy-mkt-reveal">
            <h2>Como começar</h2>
            <p>Três passos para marcar sua consulta na PsyAll.</p>
        </header>
        <div class="row g-4">
            <div class="col-md-4 psy-mkt-reveal">
                <div class="psy-step">
                    <span class="psy-step-num">1</span>
                    <h3>Crie sua conta</h3>
                    <p>Cadastro gratuito como paciente — sem compromisso de agendar na hora.</p>
                </div>
            </div>
            <div class="col-md-4 psy-mkt-reveal">
                <div class="psy-step">
                    <span class="psy-step-num">2</span>
                    <h3>Escolha o profissional</h3>
                    <p>Veja CRP, especialidades, avaliações e disponibilidade.</p>
                </div>
            </div>
            <div class="col-md-4 psy-mkt-reveal">
                <div class="psy-step">
                    <span class="psy-step-num">3</span>
                    <h3>Agende e compareça</h3>
                    <p>Confirme o horário, entre na sala online ou no presencial e, depois, avalie.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="psy-section" id="preco-justo">
    <div class="container">
        <div class="psy-mkt-split psy-mkt-reveal">
            <div>
                <p class="psy-eyebrow mb-2">Transparência</p>
                <h2>Consultas a R$&nbsp;50 na plataforma</h2>
                <p>
                    O valor intermediado pela PsyAll é de <strong>R$&nbsp;50,00</strong> por sessão,
                    conforme o contrato dos psicólogos. Isso amplia o acesso à terapia e remunera
                    profissionais validados — com custos reais de infraestrutura digital por trás.
                </p>
                <a href="/valor-social" class="btn btn-psy-ghost mt-2">Entenda o valor social do que você paga</a>
            </div>
        </div>
    </div>
</section>

<section class="psy-section psy-cta">
    <div class="container text-center psy-mkt-reveal">
        <h2>Pronto para cuidar de você?</h2>
        <p>Crie sua conta ou explore os psicólogos ativos na PsyAll.</p>
        <div class="d-flex flex-wrap gap-3 justify-content-center">
            <a href="/Account/CriarConta" class="btn btn-light btn-lg">Criar conta</a>
            <a href="/agendamento" class="btn btn-outline-light btn-lg">Agendar consulta</a>
            <a href="/#psicologos" class="btn btn-outline-light btn-lg">Ver psicólogos</a>
        </div>
    </div>
</section>
