@page "/psicologo/documentos"
@using Microsoft.AspNetCore.Authorization
@using ClinicaPsi.Shared.Models
@attribute [Authorize(Roles = "Psicologo")]
@model ClinicaPsi.Web.Pages.Psicologo.DocumentosModel
@{
    ViewData["Title"] = "Gerar Documentos";
    Layout = "_AdminLayout";
}

<div class="admin-page-header">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h1 class="admin-page-title mb-2">
                <i class="bi bi-file-earmark-text me-2"></i>
                Gerar Documentos
            </h1>
            <p class="admin-page-subtitle mb-0">
                Emita declarações e documentos em PDF para seus pacientes.
            </p>
        </div>
        <a href="/psicologo" class="admin-action-btn-secondary">
            <i class="bi bi-arrow-left"></i> Voltar
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show app-alert" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show app-alert" role="alert">
        <i class="bi bi-check-circle me-2"></i> @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Pacientes.Count == 0)
{
    <div class="admin-card mb-4">
        <div class="admin-card-body">
            <div class="empty-state">
                <div class="empty-state__icon"><i class="bi bi-people"></i></div>
                <div class="empty-state__title">Nenhum paciente cadastrado</div>
                <p class="empty-state__text">Cadastre pacientes antes de gerar documentos.</p>
                <a href="/psicologo/pacientes" class="admin-action-btn">
                    <i class="bi bi-person-plus"></i> Ir para pacientes
                </a>
            </div>
        </div>
    </div>
}

<div class="row g-4">
    <div class="col-md-6">
        <div class="admin-card h-100">
            <div class="admin-card-header">
                <h5 class="mb-0"><i class="bi bi-file-earmark-check me-2"></i> Declaração de Comparecimento</h5>
            </div>
            <div class="admin-card-body">
                <p class="text-muted">Gere uma declaração de comparecimento para consulta.</p>
                <form method="post" asp-page-handler="GerarDeclaracao">
                    <div class="mb-3">
                        <label class="form-label">Selecione o Paciente <span class="text-danger">*</span></label>
                        <select class="form-select" name="pacienteId" required>
                            <option value="">Escolha um paciente...</option>
                            @foreach (var paciente in Model.Pacientes)
                            {
                                <option value="@paciente.Id">@paciente.Nome - CPF: @paciente.CPF</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Data da Consulta <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" name="dataConsulta"
                               value="@DateTime.Now.ToString("yyyy-MM-dd")"
                               max="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Horário da Consulta <span class="text-danger">*</span></label>
                        <input type="time" class="form-control" name="horaConsulta"
                               value="@DateTime.Now.ToString("HH:mm")" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Duração (minutos)</label>
                        <input type="number" class="form-control" name="duracao" min="30" max="180" value="50" required />
                    </div>
                    <button type="submit" class="admin-action-btn w-100 justify-content-center">
                        <i class="bi bi-file-pdf"></i> Gerar Declaração PDF
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="admin-card h-100">
            <div class="admin-card-header">
                <h5 class="mb-0"><i class="bi bi-file-earmark-medical me-2"></i> Atestado</h5>
            </div>
            <div class="admin-card-body">
                <p class="text-muted">Gere um atestado com período de afastamento.</p>
                <form method="post" asp-page-handler="GerarAtestado">
                    <div class="mb-3">
                        <label class="form-label">Selecione o Paciente <span class="text-danger">*</span></label>
                        <select class="form-select" name="pacienteId" required>
                            <option value="">Escolha um paciente...</option>
                            @foreach (var paciente in Model.Pacientes)
                            {
                                <option value="@paciente.Id">@paciente.Nome - CPF: @paciente.CPF</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Data da Consulta <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" name="dataConsulta"
                               value="@DateTime.Now.ToString("yyyy-MM-dd")"
                               max="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Horário da Consulta <span class="text-danger">*</span></label>
                        <input type="time" class="form-control" name="horaConsulta"
                               value="@DateTime.Now.ToString("HH:mm")" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">CID-10 (Opcional)</label>
                        <input type="text" class="form-control" name="cid" placeholder="Ex: F41.1" maxlength="10" />
                        <small class="text-muted">Código Internacional de Doenças</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Dias de Afastamento <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" name="diasAfastamento" min="1" max="90" value="1" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Observações (Opcional)</label>
                        <textarea class="form-control" name="observacoes" rows="3" maxlength="500"></textarea>
                    </div>
                    <button type="submit" class="admin-action-btn w-100 justify-content-center">
                        <i class="bi bi-file-pdf"></i> Gerar Atestado PDF
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="admin-card mt-4">
    <div class="admin-card-body">
        <p class="mb-0">
            <i class="bi bi-info-circle text-success me-1"></i>
            Você pode gerar documentos para consultas que ainda não estão no sistema — informe paciente, data e horário.
            Pacientes disponíveis: <strong>@Model.Pacientes.Count</strong>.
        </p>
    </div>
</div>
