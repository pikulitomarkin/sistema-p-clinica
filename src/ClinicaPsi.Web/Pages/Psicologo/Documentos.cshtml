@page "/psicologo/documentos"
@using Microsoft.AspNetCore.Authorization
@using ClinicaPsi.Shared.Models
@attribute [Authorize(Roles = "Psicologo")]
@model ClinicaPsi.Web.Pages.Psicologo.DocumentosModel
@{
    ViewData["Title"] = "Gerar Documentos";
    Layout = "_AdminLayout";
}

<div class="container my-5">
    <div class="row">
        <div class="col-lg-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="bi bi-file-earmark-text"></i> Gerar Documentos</h2>
                <a href="/psicologo" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Voltar
                </a>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Recibo Serviços de Saúde -->
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header text-white" style="background-color: #0d9488;">
                    <h5 class="mb-0"><i class="bi bi-receipt"></i> Recibo de Prestação de Serviços de Saúde</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning mb-3 py-2">
                        <small>
                            <strong>Receita Saúde (RFB):</strong> o recibo oficial para IR é emitido no
                            <em>App Receita Federal</em> ou no <em>Carnê-Leão Web</em> (profissional PF).
                            Aqui você gera um <strong>PDF interno</strong> para o paciente e, se quiser,
                            um <strong>CSV</strong> no formato de escrituração para importar no Carnê-Leão.
                            Não há API pública da Receita Federal para emitir direto pelo sistema.
                        </small>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Paciente <span class="text-danger">*</span></label>
                            <select class="form-select" name="pacienteId" form="formReciboPdf" required id="reciboPacienteId">
                                <option value="">Escolha um paciente...</option>
                                @foreach (var paciente in Model.Pacientes)
                                {
                                    <option value="@paciente.Id">
                                        @paciente.Nome - CPF: @paciente.CPF
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Data do pagamento <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" name="dataPagamento" form="formReciboPdf"
                                   id="reciboDataPagamento" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Data do atendimento</label>
                            <input type="date" class="form-control" name="dataAtendimento" form="formReciboPdf"
                                   id="reciboDataAtendimento" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Valor (R$) <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" name="valor" form="formReciboPdf" id="reciboValor"
                                   step="0.01" min="0.01"
                                   value="@Model.ValorConsultaPadrao.ToString(System.Globalization.CultureInfo.InvariantCulture)" required />
                        </div>
                        <div class="col-md-9">
                            <label class="form-label">Descrição do serviço</label>
                            <input type="text" class="form-control" name="descricao" form="formReciboPdf" id="reciboDescricao"
                                   maxlength="255" value="@Model.DescricaoPadrao" placeholder="Consulta psicológica" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">CPF do pagador (se diferente do paciente)</label>
                            <input type="text" class="form-control" name="cpfPagador" form="formReciboPdf" id="reciboCpfPagador"
                                   maxlength="14" placeholder="Opcional — usa CPF do paciente se vazio" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">CPF do profissional (PF)</label>
                            <input type="text" class="form-control" name="cpfProfissional" form="formReciboPdf" id="reciboCpfProf"
                                   maxlength="14" placeholder="Obrigatório para CSV; opcional no PDF" />
                            <small class="text-muted">Pode vir do perfil do usuário ou da config ReceitaSaude.CpfProfissionalPadrao.</small>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2 mt-3">
                        <form method="post" asp-page-handler="GerarReciboSaude" id="formReciboPdf" class="d-inline">
                            <button type="submit" class="btn text-white" style="background-color: #0d9488;">
                                <i class="bi bi-file-pdf"></i> Gerar PDF do recibo
                            </button>
                        </form>
                        <form method="post" asp-page-handler="ExportarCsvCarneLeao" id="formReciboCsv" class="d-inline"
                              onsubmit="syncReciboFields(this); return true;">
                            <input type="hidden" name="pacienteId" />
                            <input type="hidden" name="dataPagamento" />
                            <input type="hidden" name="dataAtendimento" />
                            <input type="hidden" name="valor" />
                            <input type="hidden" name="descricao" />
                            <input type="hidden" name="cpfPagador" />
                            <input type="hidden" name="cpfProfissional" />
                            <button type="submit" class="btn btn-outline-secondary">
                                <i class="bi bi-filetype-csv"></i> Exportar CSV Carnê-Leão
                            </button>
                        </form>
                    </div>
                    <script>
                        (function () {
                            var sharedIds = ['reciboPacienteId', 'reciboDataPagamento', 'reciboDataAtendimento',
                                'reciboValor', 'reciboDescricao', 'reciboCpfPagador', 'reciboCpfProf'];
                            var names = ['pacienteId', 'dataPagamento', 'dataAtendimento', 'valor', 'descricao', 'cpfPagador', 'cpfProfissional'];
                            window.syncReciboFields = function (form) {
                                for (var i = 0; i < sharedIds.length; i++) {
                                    var src = document.getElementById(sharedIds[i]);
                                    var dst = form.querySelector('[name="' + names[i] + '"]');
                                    if (src && dst) dst.value = src.value;
                                }
                            };
                        })();
                    </script>
                </div>
            </div>
        </div>

        <!-- Card Declaração de Comparecimento -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-file-earmark-check"></i> Declaração de Comparecimento</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Gere uma declaração de comparecimento para consulta.</p>
                    
                    <form method="post" asp-page-handler="GerarDeclaracao">
                        <div class="mb-3">
                            <label class="form-label">Selecione o Paciente <span class="text-danger">*</span></label>
                            <select class="form-select" name="pacienteId" required>
                                <option value="">Escolha um paciente...</option>
                                @foreach (var paciente in Model.Pacientes)
                                {
                                    <option value="@paciente.Id">
                                        @paciente.Nome - CPF: @paciente.CPF
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Data da Consulta <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" name="dataConsulta" 
                                   value="@DateTime.Now.ToString("yyyy-MM-dd")" 
                                   max="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Horário da Consulta <span class="text-danger">*</span></label>
                            <input type="time" class="form-control" name="horaConsulta" 
                                   value="@DateTime.Now.ToString("HH:mm")" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Duração (minutos)</label>
                            <input type="number" class="form-control" name="duracao" min="30" max="180" value="50" required />
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-file-pdf"></i> Gerar Declaração PDF
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Card Atestado -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-file-earmark-medical"></i> Atestado Médico</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Gere um atestado médico com período de afastamento.</p>
                    
                    <form method="post" asp-page-handler="GerarAtestado">
                        <div class="mb-3">
                            <label class="form-label">Selecione o Paciente <span class="text-danger">*</span></label>
                            <select class="form-select" name="pacienteId" required>
                                <option value="">Escolha um paciente...</option>
                                @foreach (var paciente in Model.Pacientes)
                                {
                                    <option value="@paciente.Id">
                                        @paciente.Nome - CPF: @paciente.CPF
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Data da Consulta <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" name="dataConsulta" 
                                   value="@DateTime.Now.ToString("yyyy-MM-dd")" 
                                   max="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Horário da Consulta <span class="text-danger">*</span></label>
                            <input type="time" class="form-control" name="horaConsulta" 
                                   value="@DateTime.Now.ToString("HH:mm")" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">CID-10 (Opcional)</label>
                            <input type="text" class="form-control" name="cid" placeholder="Ex: F41.1" maxlength="10" />
                            <small class="text-muted">Código Internacional de Doenças</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Dias de Afastamento <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" name="diasAfastamento" min="1" max="90" value="1" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Observações (Opcional)</label>
                            <textarea class="form-control" name="observacoes" rows="3" maxlength="500"></textarea>
                        </div>

                        <button type="submit" class="btn btn-success w-100">
                            <i class="bi bi-file-pdf"></i> Gerar Atestado PDF
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Informação sobre Pacientes -->
    <div class="row mt-5">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="bi bi-info-circle"></i> Informação</h5>
                </div>
                <div class="card-body">
                    <p class="mb-0">
                        <i class="bi bi-lightbulb text-warning"></i> 
                        <strong>Nota:</strong> Esta página permite gerar documentos para consultas que não estão registradas no sistema.
                        Selecione o paciente e informe a data/hora da consulta manualmente.
                    </p>
                    <p class="mb-0 mt-2">
                        <i class="bi bi-people text-primary"></i> 
                        Total de pacientes disponíveis: <strong>@Model.Pacientes.Count</strong>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
