@page "{id:int}"
@model ClinicaPsi.Web.Pages.Psicologo.SalaConsultaModel
@using ClinicaPsi.Shared.Models
@using ClinicaPsi.Web.Extensions
@{
    ViewData["Title"] = $"Sala da consulta #{Model.Consulta.Id}";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
    var consulta = Model.Consulta;
}

<div class="mb-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a asp-page="/Psicologo/Index">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-page="/Psicologo/Agenda">Agenda</a></li>
            <li class="breadcrumb-item active">Sala #@consulta.Id</li>
        </ol>
    </nav>
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
            <h2 class="gradient-text mb-1">
                <i class="bi bi-camera-video me-2"></i>Sala da consulta
            </h2>
            <p class="text-muted mb-0">
                <strong>@(consulta.Paciente?.Nome ?? "Paciente")</strong>
                · @consulta.DataHorario.ToString("dd/MM/yyyy HH:mm")
                · @consulta.DuracaoMinutos min
                · <span class="badge status-@consulta.Status.ToString().ToLower()">@consulta.Status.GetDisplayName()</span>
                @if (consulta.PacienteChamado)
                {
                    <span class="badge bg-warning text-dark ms-1">Paciente chamado</span>
                }
            </p>
        </div>
        <a asp-page="/Psicologo/Agenda" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Voltar à agenda
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.MensagemSucesso))
{
    <div class="alert alert-success alert-dismissible fade show">@Model.MensagemSucesso
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.MensagemInfo))
{
    <div class="alert alert-info alert-dismissible fade show">@Model.MensagemInfo
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.MensagemErro))
{
    <div class="alert alert-danger alert-dismissible fade show">@Model.MensagemErro
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4 sala-consulta">
    <div class="col-xl-7">
        <div class="card card-modern h-100">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h5 class="mb-0"><i class="bi bi-camera-video me-2"></i>Vídeo</h5>
                <div class="d-flex gap-2 flex-wrap">
                    <form method="post" asp-page-handler="IniciarVideo" asp-route-id="@consulta.Id" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="bi bi-play-circle me-1"></i>Iniciar videochamada
                        </button>
                    </form>
                    <form method="post" asp-page-handler="ChamarPaciente" asp-route-id="@consulta.Id" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success btn-sm">
                            <i class="bi bi-telephone-outbound me-1"></i>Chamar paciente
                        </button>
                    </form>
                    @if (!string.IsNullOrWhiteSpace(Model.EmbedUrl))
                    {
                        <a class="btn btn-outline-primary btn-sm" href="@Model.EmbedUrl" target="_blank" rel="noopener">
                            <i class="bi bi-box-arrow-up-right me-1"></i>Abrir em nova aba
                        </a>
                    }
                </div>
            </div>
            <div class="card-body p-0">
                @if (Model.VideoIniciado && !string.IsNullOrWhiteSpace(Model.EmbedUrl))
                {
                    <div class="ratio ratio-16x9 bg-dark" style="min-height: 420px;">
                        <iframe src="@Model.EmbedUrl"
                                allow="camera; microphone; fullscreen; display-capture; autoplay"
                                allowfullscreen
                                title="Sala de videochamada"></iframe>
                    </div>
                }
                else
                {
                    <div class="p-5 text-center text-muted video-placeholder">
                        <i class="bi bi-camera-video-off display-4 d-block mb-3"></i>
                        <p class="mb-1">Clique em <strong>Iniciar videochamada</strong> para abrir o Jitsi.</p>
                        <p class="small mb-0">Use <strong>Chamar paciente</strong> para enviar e-mail e notificação.</p>
                        @if (!string.IsNullOrWhiteSpace(consulta.VideoRoomName))
                        {
                            <p class="small mt-3 mb-0">Sala preparada: <code>@consulta.VideoRoomName</code></p>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-xl-5">
        <div class="card card-modern mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-journal-medical me-2"></i>Prontuário da sessão</h5>
            </div>
            <div class="card-body">
                <form method="post" asp-page-handler="SalvarProntuario" asp-route-id="@consulta.Id">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Input.Id" />
                    <div class="mb-3">
                        <label class="form-label" asp-for="Input.QueixaPrincipal">Queixa principal</label>
                        <input asp-for="Input.QueixaPrincipal" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="Input.Observacoes">Observações</label>
                        <textarea asp-for="Input.Observacoes" class="form-control" rows="3" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="Input.Evolucao">Evolução</label>
                        <textarea asp-for="Input.Evolucao" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="Input.Intervencoes">Intervenções</label>
                        <textarea asp-for="Input.Intervencoes" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="Input.EstadoEmocional">Estado emocional</label>
                        <input asp-for="Input.EstadoEmocional" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="Input.PlanoTerapeutico">Plano terapêutico</label>
                        <textarea asp-for="Input.PlanoTerapeutico" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="Input.ProximaSessao">Próxima sessão</label>
                        <textarea asp-for="Input.ProximaSessao" class="form-control" rows="2"></textarea>
                    </div>
                    <button type="submit" class="btn btn-success w-100">
                        <i class="bi bi-save me-1"></i>Salvar prontuário
                    </button>
                </form>
            </div>
        </div>

        <div class="card card-modern">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-file-earmark-pdf me-2"></i>Documentos</h5>
            </div>
            <div class="card-body d-grid gap-3">
                <div>
                    <p class="small text-muted mb-2">Declaração de comparecimento com dados da consulta.</p>
                    <a class="btn btn-outline-primary w-100"
                       asp-page-handler="Declaracao"
                       asp-route-id="@consulta.Id">
                        <i class="bi bi-file-text me-1"></i>Emitir declaração (PDF)
                    </a>
                </div>
                <hr class="my-1" />
                <form method="post" asp-page-handler="Atestado" asp-route-id="@consulta.Id">
                    @Html.AntiForgeryToken()
                    <p class="small text-muted mb-2">Atestado com período de afastamento.</p>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small" asp-for="Atestado.Cid">CID (opcional)</label>
                            <input asp-for="Atestado.Cid" class="form-control form-control-sm" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small" asp-for="Atestado.DiasAfastamento">Dias</label>
                            <input asp-for="Atestado.DiasAfastamento" type="number" min="1" max="90" class="form-control form-control-sm" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small" asp-for="Atestado.Observacoes">Observações</label>
                            <input asp-for="Atestado.Observacoes" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-outline-danger w-100">
                        <i class="bi bi-clipboard2-pulse me-1"></i>Emitir atestado (PDF)
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .sala-consulta .video-placeholder {
        min-height: 420px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        background: linear-gradient(160deg, #f8faf9 0%, #e8f5ee 100%);
    }
    .badge.status-agendada { background-color: #007bff; }
    .badge.status-confirmada { background-color: #28a745; }
    .badge.status-realizada { background-color: #6f42c1; }
    .badge.status-cancelada { background-color: #dc3545; }
    .badge.status-noshow { background-color: #fd7e14; }
    .badge.status-reagendada { background-color: #20c997; }
</style>
