@page "/psicologo"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using ClinicaPsi.Shared.Models
@using ClinicaPsi.Application.Services
@inject UserManager<ApplicationUser> UserManager
@inject ConsultaService ConsultaService
@inject PacienteService PacienteService
@model ClinicaPsi.Web.Pages.Psicologo.IndexModel
@{
    ViewData["Title"] = "Dashboard do Psicólogo";
    Layout = "_AdminLayout";
}

@if (ViewData["DebugMessage"] != null)
{
    <div class="alert alert-warning app-alert">
        <strong>Debug:</strong> @ViewData["DebugMessage"]
    </div>
}

<div class="admin-page-header">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h1 class="admin-page-title mb-2">
                <i class="bi bi-person-badge me-2"></i>
                Área do Psicólogo
            </h1>
            <p class="admin-page-subtitle mb-0">
                Bem-vindo(a), @User.Identity?.Name — gerencie agenda, pacientes e atendimento.
            </p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a href="/psicologo/agenda" class="admin-action-btn">
                <i class="bi bi-calendar-week"></i>
                Abrir Agenda
            </a>
            <a href="/psicologo/pacientes" class="admin-action-btn-secondary">
                <i class="bi bi-people"></i>
                Pacientes
            </a>
        </div>
    </div>
</div>

<div class="row g-3 g-lg-4 mb-4">
    <div class="col-6 col-lg-3">
        <div class="admin-stats-card h-100">
            <div class="stats-icon"><i class="bi bi-calendar-check"></i></div>
            <div class="stats-number">@Model.ConsultasHoje</div>
            <div class="stats-label">Consultas hoje</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="admin-stats-card h-100">
            <div class="stats-icon" style="background: linear-gradient(135deg, #17a2b8, #138496);">
                <i class="bi bi-calendar3"></i>
            </div>
            <div class="stats-number">@Model.ConsultasProximos7Dias</div>
            <div class="stats-label">Próximos 7 dias</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="admin-stats-card h-100">
            <div class="stats-icon" style="background: linear-gradient(135deg, #4a7c59, #28a745);">
                <i class="bi bi-people"></i>
            </div>
            <div class="stats-number">@Model.TotalPacientes</div>
            <div class="stats-label">Pacientes ativos</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="admin-stats-card h-100">
            <div class="stats-icon" style="background: linear-gradient(135deg, #20c997, #17a2b8);">
                <i class="bi bi-check-circle"></i>
            </div>
            <div class="stats-number">@Model.ConsultasRealizadas</div>
            <div class="stats-label">Realizadas no mês</div>
        </div>
    </div>
</div>

<div class="admin-card mb-4">
    <div class="admin-card-header">
        <h5 class="mb-0"><i class="bi bi-lightning-charge me-2"></i>Atalhos</h5>
    </div>
    <div class="admin-card-body">
        <div class="quick-actions">
            <a class="quick-action" href="/psicologo/agenda">
                <i class="bi bi-calendar-week"></i>
                <strong>Agenda</strong>
                <span>Compromissos e sala de vídeo</span>
            </a>
            <a class="quick-action" href="/psicologo/consultas">
                <i class="bi bi-clipboard-check"></i>
                <strong>Consultas</strong>
                <span>Gerenciar sessões</span>
            </a>
            <a class="quick-action" href="/psicologo/pacientes">
                <i class="bi bi-person-lines-fill"></i>
                <strong>Pacientes</strong>
                <span>Cadastro e fichas</span>
            </a>
            <a class="quick-action" href="/prontuario">
                <i class="bi bi-file-medical"></i>
                <strong>Prontuário</strong>
                <span>Evolução clínica</span>
            </a>
            <a class="quick-action" href="/psicologo/documentos">
                <i class="bi bi-file-earmark-text"></i>
                <strong>Documentos</strong>
                <span>Declarações em PDF</span>
            </a>
            <a class="quick-action" href="/psicologo/relatorios">
                <i class="bi bi-graph-up"></i>
                <strong>Relatórios</strong>
                <span>Visão mensal</span>
            </a>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="admin-card">
            <div class="admin-card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h5 class="mb-0"><i class="bi bi-calendar-event me-2"></i>Próximas consultas</h5>
                <a href="/psicologo/agenda" class="btn btn-sm btn-outline-success">Ver agenda</a>
            </div>
            <div class="admin-card-body">
                @if (Model.ProximasConsultas.Any())
                {
                    <div class="table-responsive">
                        <table class="admin-table table mb-0">
                            <thead>
                                <tr>
                                    <th>Paciente</th>
                                    <th>Data/Hora</th>
                                    <th>Duração</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var consulta in Model.ProximasConsultas.Take(6))
                                {
                                    <tr>
                                        <td>
                                            <strong>@consulta.Paciente?.Nome</strong>
                                            @if (consulta.Tipo == TipoConsulta.Gratuita)
                                            {
                                                <span class="badge bg-warning text-dark ms-1">Gratuita</span>
                                            }
                                        </td>
                                        <td>@consulta.DataHorario.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@consulta.DuracaoMinutos min</td>
                                        <td class="text-end">
                                            @if (consulta.Formato == FormatoConsulta.Online)
                                            {
                                                <a href="/consulta/@consulta.Id/video" class="btn btn-sm btn-success" title="Sala de vídeo">
                                                    <i class="bi bi-camera-video"></i>
                                                </a>
                                            }
                                            <a href="/psicologo/consultas" class="btn btn-sm btn-outline-secondary" title="Consultas">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-state__icon"><i class="bi bi-calendar-x"></i></div>
                        <div class="empty-state__title">Nenhuma consulta próxima</div>
                        <p class="empty-state__text">Quando houver agendamentos, eles aparecerão aqui.</p>
                        <a href="/psicologo/agenda" class="admin-action-btn">
                            <i class="bi bi-calendar-week"></i> Ir para agenda
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="admin-card">
            <div class="admin-card-header">
                <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Seus dados</h5>
            </div>
            <div class="admin-card-body">
                <dl class="row mb-0 small">
                    <dt class="col-5 text-muted">Valor</dt>
                    <dd class="col-7">R$ @(Model.ValorConsulta?.ToString("N2") ?? "0,00")</dd>
                    <dt class="col-5 text-muted">CRP</dt>
                    <dd class="col-7">@(Model.CRP ?? "Não informado")</dd>
                    <dt class="col-5 text-muted">Horário</dt>
                    <dd class="col-7">
                        @if (Model.AtendeManha && Model.AtendeTarde)
                        {
                            <text>Manhã e tarde</text>
                        }
                        else if (Model.AtendeManha)
                        {
                            <text>Manhã</text>
                        }
                        else if (Model.AtendeTarde)
                        {
                            <text>Tarde</text>
                        }
                        else
                        {
                            <text>Não configurado</text>
                        }
                    </dd>
                </dl>
                <div class="mt-3">
                    <a href="/psicologo/perfil" class="admin-action-btn-secondary w-100 justify-content-center">
                        <i class="bi bi-person-gear"></i> Atualizar perfil
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
