@page "/psicologo/relatorios/mensal"
@model ClinicaPsi.Web.Pages.Psicologo.RelatorioMensalModel
@using ClinicaPsi.Shared.Models
@using System.Globalization
@{
    ViewData["Title"] = "Relatório Mensal";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
    var cultura = new CultureInfo("pt-BR");
    var nomeMes = cultura.DateTimeFormat.GetMonthName(Model.MesSelecionado);
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="gradient-text mb-1">
            <i class="bi bi-calendar3 me-2"></i>
            Relatório Mensal
        </h2>
        <p class="text-muted mb-0 text-capitalize">
            @nomeMes de @Model.AnoSelecionado · @Model.NomePsicologoFiltro
        </p>
    </div>
    <a href="/psicologo/relatorios" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>
        Relatórios gerais
    </a>
</div>

<div class="card card-modern mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3 col-6">
                <label for="mes" class="form-label">Mês</label>
                <select class="form-select" id="mes" name="mes" asp-items="Model.MesesDisponiveis"></select>
            </div>
            <div class="col-md-3 col-6">
                <label for="ano" class="form-label">Ano</label>
                <select class="form-select" id="ano" name="ano" asp-items="Model.AnosDisponiveis"></select>
            </div>
            @if (Model.EhAdmin)
            {
                <div class="col-md-3">
                    <label for="psicologoId" class="form-label">Psicólogo</label>
                    <select class="form-select" id="psicologoId" name="psicologoId" asp-items="Model.PsicologosDisponiveis"></select>
                </div>
            }
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel me-1"></i>
                    Filtrar
                </button>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <div class="card card-modern h-100">
            <div class="card-body text-center">
                <i class="bi bi-calendar-check text-primary" style="font-size: 1.75rem;"></i>
                <h3 class="mt-2 mb-0">@Model.TotalConsultas</h3>
                <small class="text-muted">Total no mês</small>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card card-modern h-100">
            <div class="card-body text-center">
                <i class="bi bi-clock-history text-info" style="font-size: 1.75rem;"></i>
                <h3 class="mt-2 mb-0">@Model.ConsultasAgendadas</h3>
                <small class="text-muted">Agendadas</small>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card card-modern h-100">
            <div class="card-body text-center">
                <i class="bi bi-check2-circle text-success" style="font-size: 1.75rem;"></i>
                <h3 class="mt-2 mb-0">@Model.ConsultasRealizadas</h3>
                <small class="text-muted">Realizadas</small>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card card-modern h-100">
            <div class="card-body text-center">
                <i class="bi bi-x-circle text-danger" style="font-size: 1.75rem;"></i>
                <h3 class="mt-2 mb-0">@Model.ConsultasCanceladas</h3>
                <small class="text-muted">Canceladas</small>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card card-modern h-100">
            <div class="card-body text-center">
                <i class="bi bi-currency-dollar text-success" style="font-size: 1.75rem;"></i>
                <h3 class="mt-2 mb-0">@Model.ReceitaMes.ToString("C", cultura)</h3>
                <small class="text-muted">Receita do mês (realizadas)</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-modern h-100">
            <div class="card-body text-center">
                <i class="bi bi-people text-primary" style="font-size: 1.75rem;"></i>
                <h3 class="mt-2 mb-0">@Model.PacientesAtendidos</h3>
                <small class="text-muted">Pacientes atendidos</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-modern h-100">
            <div class="card-body text-center">
                <i class="bi bi-person-x text-warning" style="font-size: 1.75rem;"></i>
                <h3 class="mt-2 mb-0">@Model.ConsultasNoShow</h3>
                <small class="text-muted">Não comparecimentos</small>
            </div>
        </div>
    </div>
</div>

<div class="card card-modern">
    <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
            <i class="bi bi-list-ul me-2"></i>
            Consultas do mês
        </h5>
        <span class="badge bg-secondary">@Model.Consultas.Count</span>
    </div>
    <div class="card-body p-0">
        @if (Model.Consultas.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Data</th>
                            <th>Paciente</th>
                            @if (Model.EhAdmin && !Model.FiltroPsicologoId.HasValue)
                            {
                                <th>Psicólogo</th>
                            }
                            <th>Status</th>
                            <th>Formato</th>
                            <th class="text-end">Valor</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var consulta in Model.Consultas)
                        {
                            <tr>
                                <td>
                                    <div>@consulta.DataHorario.ToString("dd/MM/yyyy", cultura)</div>
                                    <small class="text-muted">@consulta.DataHorario.ToString("HH:mm")</small>
                                </td>
                                <td>@consulta.PacienteNome</td>
                                @if (Model.EhAdmin && !Model.FiltroPsicologoId.HasValue)
                                {
                                    <td>@consulta.PsicologoNome</td>
                                }
                                <td>
                                    @{
                                        var (badgeClass, label) = consulta.Status switch
                                        {
                                            StatusConsulta.Realizada => ("bg-success", "Realizada"),
                                            StatusConsulta.Cancelada => ("bg-danger", "Cancelada"),
                                            StatusConsulta.NoShow => ("bg-warning text-dark", "No-show"),
                                            StatusConsulta.Confirmada => ("bg-info", "Confirmada"),
                                            StatusConsulta.Reagendada => ("bg-secondary", "Reagendada"),
                                            _ => ("bg-primary", "Agendada")
                                        };
                                    }
                                    <span class="badge @badgeClass">@label</span>
                                </td>
                                <td>
                                    @(consulta.Formato == FormatoConsulta.Online ? "Online" : "Presencial")
                                </td>
                                <td class="text-end fw-semibold">
                                    @consulta.Valor.ToString("C", cultura)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-inbox" style="font-size: 2rem;"></i>
                <p class="mt-2 mb-0">Nenhuma consulta encontrada para este período.</p>
            </div>
        }
    </div>
</div>
