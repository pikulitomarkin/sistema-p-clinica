@page "/agendamento"
@using ClinicaPsi.Shared.Models
@using Microsoft.AspNetCore.Identity
@inject ClinicaPsi.Application.Services.PsicologoService PsicologoService
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Agende sua teleterapia — PsyAll";
    ViewData["MetaDescription"] = "Agende teleterapia na PsyAll com psicólogos de CRP validado. Consultas online a R$ 50 com sala de vídeo integrada.";
    ViewData["Canonical"] = "https://psyall.com.br/agendamento";
    ViewData["OgTitle"] = "Agende sua teleterapia — PsyAll";
    Layout = "_Layout";

    var psicologos = await PsicologoService.GetAllAsync();
    var psicologosAtivos = psicologos.Where(p => p.Ativo && p.ExcluidoEm == null && p.StatusValidacao == StatusValidacaoPsicologo.Aprovado).ToList();
    var infoFallback = !psicologosAtivos.Any();
    var isLoggedIn = SignInManager.IsSignedIn(User);

    string FormatarDias(Psicologo psi)
    {
        var dias = new List<string>();
        if (psi.AtendeSegunda) dias.Add("Seg");
        if (psi.AtendeTerca) dias.Add("Ter");
        if (psi.AtendeQuarta) dias.Add("Qua");
        if (psi.AtendeQuinta) dias.Add("Qui");
        if (psi.AtendeSexta) dias.Add("Sex");
        if (psi.AtendeSabado) dias.Add("Sáb");
        if (psi.AtendeDomingo) dias.Add("Dom");
        return string.Join(", ", dias);
    }
}

<div class="public-band agenda-public">
    <div class="container py-4 pb-5">
        <header class="public-hero">
            <p class="public-kicker mb-2">Teleterapia PsyAll</p>
            <h1 class="display-5">Agende sua consulta</h1>
            <p class="lead mb-0">Escolha o psicólogo e o horário da sessão online.</p>
        </header>

        @if (infoFallback)
        {
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <article class="psy-card text-center p-4 p-md-5">
                        <div class="psy-avatar"><i class="bi bi-person"></i></div>
                        <h2 class="h3 mb-2">Dra. Ana Santos</h2>
                        <p class="text-muted mb-1"><i class="bi bi-award me-1"></i> CRP: 08/45168</p>
                        <p class="text-muted mb-3"><i class="bi bi-star-fill me-1"></i> TCC, Psicologia Organizacional</p>
                        @if (isLoggedIn)
                        {
                            <h3 class="h4 mb-4" style="color:var(--brand-primary)">R$ 150,00 <small class="text-muted fs-6">por sessão</small></h3>
                        }
                        else
                        {
                            <p class="text-muted mb-4"><i class="bi bi-lock-fill me-1"></i> Faça login para ver o valor da sessão</p>
                        }
                        <div class="alert alert-info border-0 text-start">
                            <h3 class="h5 alert-heading"><i class="bi bi-info-circle me-2"></i>Sistema em configuração</h3>
                            <p class="mb-0">Para agendar, entre em contato diretamente.</p>
                        </div>
                        <div class="d-grid gap-3 mt-4">
                            <a href="https://wa.me/5542999369724?text=Olá! Gostaria de agendar uma consulta." class="btn btn-primary btn-lg" target="_blank" rel="noopener">
                                <i class="bi bi-whatsapp me-2"></i>Agendar via WhatsApp
                            </a>
                            <a href="mailto:psiianasantos@psiianasantos.com.br" class="btn btn-outline-primary">
                                <i class="bi bi-envelope me-2"></i>Enviar e-mail
                            </a>
                        </div>
                    </article>
                </div>
            </div>
        }
        else
        {
            <div class="row g-4 mb-5">
                @foreach (var psi in psicologosAtivos)
                {
                    <div class="col-md-6 col-lg-4">
                        <article class="psy-card p-4" onclick="@(isLoggedIn ? $"window.location.href='/Cliente/AgendarConsulta?psicologoId={psi.Id}'" : "mostrarModalLogin()")">
                            <div class="text-center mb-3">
                                <div class="psy-avatar"><i class="bi bi-person"></i></div>
                                <h2 class="h4 mb-1">@psi.Nome</h2>
                                <p class="text-muted small mb-0"><i class="bi bi-award me-1"></i> CRP: @psi.CRP</p>
                            </div>
                            <div class="mb-3">
                                <h3 class="text-muted small mb-2"><i class="bi bi-star-fill me-1"></i> Especialidades</h3>
                                <p class="small mb-0">@psi.Especialidades</p>
                            </div>
                            <div class="mb-3">
                                <h3 class="text-muted small mb-2"><i class="bi bi-clock me-1"></i> Horários</h3>
                                <div class="d-flex flex-wrap gap-2">
                                    @if (psi.AtendeManha)
                                    {
                                        <span class="badge text-bg-light border">
                                            <i class="bi bi-sunrise me-1"></i>
                                            @psi.HorarioInicioManha.ToString(@"hh\:mm") - @psi.HorarioFimManha.ToString(@"hh\:mm")
                                        </span>
                                    }
                                    @if (psi.AtendeTarde)
                                    {
                                        <span class="badge text-bg-light border">
                                            <i class="bi bi-sunset me-1"></i>
                                            @psi.HorarioInicioTarde.ToString(@"hh\:mm") - @psi.HorarioFimTarde.ToString(@"hh\:mm")
                                        </span>
                                    }
                                </div>
                            </div>
                            <div class="mb-3">
                                <h3 class="text-muted small mb-2"><i class="bi bi-calendar-week me-1"></i> Dias</h3>
                                <p class="small mb-0">@FormatarDias(psi)</p>
                            </div>
                            <div class="text-center pt-3 border-top">
                                @if (isLoggedIn)
                                {
                                    <p class="h4 mb-0" style="color:var(--brand-primary)">@psi.ValorConsulta.ToString("C")</p>
                                    <small class="text-muted">por sessão</small>
                                }
                                else
                                {
                                    <p class="text-muted mb-0"><i class="bi bi-lock-fill me-1"></i> Faça login para ver o valor</p>
                                }
                            </div>
                            <div class="d-grid mt-3">
                                <button type="button" class="btn @(isLoggedIn ? "btn-primary" : "btn-outline-primary")">
                                    <i class="bi bi-calendar-check me-2"></i>@(isLoggedIn ? "Agendar consulta" : "Selecionar")
                                </button>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }

        <div class="row justify-content-center mt-4">
            <div class="col-lg-6">
                <div class="d-grid gap-3">
                    @if (!isLoggedIn)
                    {
                        <a href="/Account/Login?returnUrl=/agendamento" class="btn btn-primary btn-lg">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Fazer login
                        </a>
                        <a href="/Account/CriarConta" class="btn btn-outline-primary btn-lg">
                            <i class="bi bi-person-plus me-2"></i>Criar conta
                        </a>
                    }
                    <a href="/" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-2"></i>Voltar para a página inicial
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalLogin" tabindex="-1" aria-labelledby="modalLoginTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h2 class="modal-title h5" id="modalLoginTitulo">Login necessário</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body text-center py-4">
                <i class="bi bi-lock" style="font-size: 3rem; color: var(--brand-primary);"></i>
                <p class="mt-3 mb-4">Para agendar uma consulta, entre na sua conta ou crie uma.</p>
                <div class="d-grid gap-2">
                    <a href="/Account/Login?returnUrl=/agendamento" class="btn btn-primary">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Fazer login
                    </a>
                    <a href="/Account/CriarConta" class="btn btn-outline-primary">
                        <i class="bi bi-person-plus me-2"></i>Criar conta
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function mostrarModalLogin() {
            var modal = new bootstrap.Modal(document.getElementById('modalLogin'));
            modal.show();
        }
    </script>
}
