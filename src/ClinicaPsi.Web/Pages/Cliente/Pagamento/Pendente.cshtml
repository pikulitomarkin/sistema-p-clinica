@page "/Cliente/Pagamento/Pendente"
@model ClinicaPsi.Web.Pages.Cliente.Pagamento.PendenteModel
@{
    ViewData["Title"] = "Pagamento em análise";
    Layout = "_AdminLayout";
}

<page-header title="Pagamento em análise" subtitle="Assim que o Mercado Pago confirmar, a consulta será marcada como paga." icon="bi-hourglass-split" />
<div class="admin-card">
    <div class="admin-card-body text-center py-5">
        <div class="auth-icon mx-auto mb-3"><i class="bi bi-hourglass-split"></i></div>
        <p class="text-muted mb-4">
            Recebemos sua solicitação. PIX e outros meios assíncronos podem levar alguns minutos.
        </p>
        <a href="/Cliente/MinhasConsultas" class="btn btn-primary">Minhas Consultas</a>
        @if (Model.Consulta is not null)
        {
            <a href="/Cliente/Pagamento?consultaId=@Model.Consulta.Id" class="btn btn-outline-secondary ms-2">Ver pagamento</a>
        }
    </div>
</div>
