@page "/Cliente/Pagamento/Falha"
@model ClinicaPsi.Web.Pages.Cliente.Pagamento.FalhaModel
@{
    ViewData["Title"] = "Pagamento não concluído";
    Layout = "_AdminLayout";
}

<div class="container py-5">
    <div class="text-center mx-auto" style="max-width: 520px;">
        <div class="mb-3" style="font-size: 3rem; color: #b45309;">
            <i class="bi bi-x-circle-fill"></i>
        </div>
        <h1 class="h3 mb-2">Pagamento não concluído</h1>
        <p class="text-muted mb-4">
            Não foi possível confirmar o pagamento. Você pode tentar novamente — a consulta permanece reservada.
        </p>
        @if (Model.Consulta is not null)
        {
            <a href="/Cliente/Pagamento?consultaId=@Model.Consulta.Id" class="btn btn-primary me-2">Tentar novamente</a>
        }
        <a href="/Cliente/MinhasConsultas" class="btn btn-outline-secondary">Minhas Consultas</a>
    </div>
</div>
