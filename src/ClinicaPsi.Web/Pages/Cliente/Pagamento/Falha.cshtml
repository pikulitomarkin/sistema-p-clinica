@page "/Cliente/Pagamento/Falha"
@model ClinicaPsi.Web.Pages.Cliente.Pagamento.FalhaModel
@{
    ViewData["Title"] = "Pagamento não concluído";
    Layout = "_AdminLayout";
}

<page-header title="Pagamento não concluído" subtitle="A consulta permanece reservada para uma nova tentativa." icon="bi-x-circle" />
<div class="admin-card">
    <div class="admin-card-body text-center py-5">
        <div class="auth-icon mx-auto mb-3"><i class="bi bi-x-circle-fill"></i></div>
        <p class="text-muted mb-4">
            Não foi possível confirmar o pagamento. Você pode tentar novamente.
        </p>
        @if (Model.Consulta is not null)
        {
            <a href="/Cliente/Pagamento?consultaId=@Model.Consulta.Id" class="btn btn-primary me-2">Tentar novamente</a>
        }
        <a href="/Cliente/MinhasConsultas" class="btn btn-outline-secondary">Minhas Consultas</a>
    </div>
</div>
