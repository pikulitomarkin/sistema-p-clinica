@page "/Cliente/Pagamento/Sucesso"
@model ClinicaPsi.Web.Pages.Cliente.Pagamento.SucessoModel
@{
    ViewData["Title"] = "Pagamento confirmado";
    Layout = "_AdminLayout";
}

<page-header title="Pagamento confirmado" subtitle="A consulta foi marcada como paga." icon="bi-check-circle" />
<div class="admin-card">
    <div class="admin-card-body text-center py-5">
        <div class="auth-icon mx-auto mb-3"><i class="bi bi-check-circle-fill"></i></div>
        <p class="text-muted mb-4">
            Sua consulta @(Model.Consulta is not null ? $"com {Model.Consulta.Psicologo?.Nome} em {Model.Consulta.DataHorario:dd/MM/yyyy HH:mm}" : "") está paga.
        </p>
        <a href="/Cliente/MinhasConsultas" class="btn btn-primary">Ir para Minhas Consultas</a>
    </div>
</div>
